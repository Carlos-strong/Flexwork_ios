// Prisma schema — Flexwork
// Modèle v3 (intermédiaire neutre) — voir etat-consolide-Flexwork.md (arbitrage A11) et
// modele-skillafrica-v3-Flexwork.md (référence complète, §12 pour le modèle de données).
// Playbook d'implémentation : Prompts_Sprints_UserStories.md (Phases 1 à 8).
//
// Ce schéma remplace intégralement la version précédente (4 filières à badge, escrow
// détenu en interne, litige arbitré par la plateforme) — voir revue-architecture-v3.md
// pour le détail de ce qui a été retiré et pourquoi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1 — Comptes
// ---------------------------------------------------------------------------

// 5 profils (etat-consolide-Flexwork.md §1.1) : Client, Expert Digital, Expert BTP/Autres,
// Artisan, Manœuvre. Ne conditionne plus aucune vérification de la plateforme (contrairement
// à l'ancien concept de « filière » à badge) — uniquement l'affichage et le domaine des
// missions proposées.
enum UserRole {
  client
  expert_digital
  expert_btp_autres
  artisan
  manoeuvre
  // Responsable chantier (2026-09-14, §8 du prompt S2) — valide les relevés de présence des
  // travailleurs sur les chantiers dont il a la charge.
  //
  // Ce n'est PAS un prestataire : il ne candidate pas, ne soumet pas de devis et n'a pas de
  // wallet. C'est un délégataire du client sur le terrain, et son unique pouvoir est celui que
  // le client lui confie explicitement, contrat par contrat (SpotTimeTerms.siteManagerId). Sans
  // désignation, ce compte ne peut rien valider — le rôle seul n'ouvre aucun droit.
  responsable_chantier
}

enum UserStatus {
  active
  suspended
  banned
}

// Séparation des pouvoirs administratifs (modele-skillafrica-v3-Flexwork.md §13) : 5 rôles
// distincts, chacun avec SON tableau de bord et SA sidebar (src/lib/admin-roles.ts déclare la
// superposition rôle ↔ modules, qui doit rester alignée sur les gardes d'API ci-dessous).
// `null` = pas un admin. Un admin garde `isAdmin = true` pour compat des guards existants,
// `adminRole` porte la granularité de pouvoir.
enum AdminRole {
  kyc
  moderation
  mediation
  superviseur
  // Éditeur du contenu public (2026-09-21) — taxonomie, sections d'accueil, menus, référencement.
  // Cinquième pouvoir distinct plutôt qu'une prérogative de plus pour le superviseur : éditer
  // ce que le visiteur lit n'est ni instruire un KYC, ni arbitrer un litige, ni toucher aux
  // flux financiers, et la règle §13 veut qu'un pouvoir qui ne recoupe pas les autres ait son
  // propre rôle. Ce rôle ne donne aucun accès aux personnes, aux missions ni à l'argent.
  frontend
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  emailVerified        DateTime?
  tel                  String     @unique
  telVerified          Boolean    @default(false)
  passwordHash         String?
  role                 UserRole   @default(client)
  firstname            String?
  lastname             String?
  // Chemin de stockage de la photo de profil (bucket "avatars", voir src/lib/storage.ts) —
  // jamais l'URL servie directement : GET /api/users/[id]/avatar la lit et la diffuse à la
  // demande, pour ne jamais exposer le chemin de stockage brut (UUID inclus) aux autres
  // utilisateurs qui la voient dans les cartes de mission/candidature. Null = pas de photo,
  // repli sur les initiales côté vue (voir src/components/avatar.tsx).
  avatarPath           String?
  country              String?
  state                String?
  city                 String?
  locality             String?
  address              String?
  status               UserStatus @default(active)
  isAdmin              Boolean    @default(false)
  adminRole            AdminRole?
  kycStatus            KycStatus  @default(en_attente)
  // ── Espace prestataire (2026-09-23) : décision « Option C » ────────────────────────────
  // Tout compte s'ouvre en CLIENT. Devenir prestataire est une ACTION explicite, jamais un
  // état déduit : sans ce drapeau, l'écran de choix du rôle n'aurait rien à enregistrer, et
  // « répondre aux missions » s'ouvrirait à un compte qui n'a rien demandé.
  //
  // Il est distinct de `role` à dessein. `role` dit QUELLE filière (artisan, manœuvre,
  // expert digital…) et pilote l'affichage et le domaine des missions proposées ; `isProvider`
  // dit que l'espace prestataire est ouvert. Un client promu artisan a besoin des deux, et
  // un artisan redevenu client garde sa filière sans candidater.
  isProvider           Boolean    @default(false)
  providerActivatedAt  DateTime?
  deviceFingerprint    String? // US-1308 (héritée) : anti-doublon de comptes
  // Consentement CGU + politique de confidentialité, horodaté à la création du compte
  // (2026-09-23). La case était cochée à l'inscription mais n'était enregistrée nulle part :
  // rien ne permettait de prouver qu'un compte donné avait accepté quoi que ce soit.
  // Nullable pour les comptes créés avant cette date, dont le consentement n'a pas été gardé.
  cgvAcceptedAt        DateTime?
  // A13 — extraite de la pièce d'identité et saisie par l'Admin KYC au moment de la
  // décision (jamais déclarée par l'utilisateur lui-même). Seule donnée d'âge faisant foi
  // pour le contrôle des filières chantier (etat-consolide-Flexwork.md §2, A13).
  dateNaissance        DateTime?
  dateNaissanceSetById String?
  dateNaissanceSetAt   DateTime?

  // Exigence de garant (2026-09-09) — activée par l'Admin KYC, compte par compte, quand il
  // l'estime nécessaire. Désactivée PAR DÉFAUT pour toutes les filières concernées (artisan,
  // manœuvre, expert_btp_autres) : sans cette activation, aucune candidature n'exige de
  // garant, même en présentiel/hybride. Quand elle est active, la candidature à une mission
  // présentiel/hybride exige un garant obligatoire (candidature-guard.ts → hasRequiredGarants).
  garantRequired        Boolean   @default(false)
  garantRequiredSetById String?
  garantRequiredSetAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes        OtpCode[]
  attendances     Attendance[]     @relation("AttendanceWorker")
  // Contrats et missions sur lesquels un client a désigné ce compte responsable de chantier
  // (mode de vérification OPR, 2026-10-01). La désignation vit sur le contrat (et, avant lui, sur
  // la mission) — jamais sur le rôle : elle doit rester révocable.
  managedContracts PrestationContract[] @relation("SiteManagedContracts")
  managedMissions  Mission[]            @relation("MissionSiteManager")
  kycDocuments    KycDocument[]
  kycReviewsDone  KycDocument[]    @relation("KycReviewer")
  livenessChecks  LivenessCheck[]
  selfieMatchLogs SelfieMatchLog[]
  // KYC financier Mobile Money (2026-09-23) — un seul compte de versement par personne,
  // d'où l'unicité plutôt qu'une collection.
  payoutAccount   PayoutAccount?
  payoutReviewsDone PayoutAccount[] @relation("PayoutReviewer")
  profiles        Profile[] // Multi-profils 2026-08-06 : remplace l'ancien profile Profile?
  clientProfile   ClientProfile? // Côté client — indépendant de `profiles` (côté prestataire)
  missionDraftAttachments MissionDraftAttachment[] // Pièces jointes déposées avant création

  missionsClient       Mission[]             @relation("MissionClient")
  proposalsSoumises    MissionProposal[]     @relation("ProposalProvider")
  missionNotifications MissionNotification[]
  messagesEnvoyes      Message[]
  avisRediges          Review[]              @relation("ReviewAuthor")
  avisRecus            Review[]              @relation("ReviewTarget")

  contractsAsClient   PrestationContract[] @relation("ContractClient")
  contractsAsProvider PrestationContract[] @relation("ContractProvider")

  // Modèle Gig (prestataire publie, client achète) — flux de signature INVERSE du modèle
  // Mission (client 1/2, prestataire 2/2, 24h sinon remboursement).
  gigsPublies         Gig[]      @relation("GigProvider")
  gigOrdersAsClient   GigOrder[] @relation("GigOrderClient")
  gigOrdersAsProvider GigOrder[] @relation("GigOrderProvider")

  digitalCertificates DigitalCertificate[]

  mediationsOuvertes   Mediation[] @relation("MediationOpenedBy")
  mediationsInstruites Mediation[] @relation("MediationAdmin")

  acknowledgementsClient ClientAcknowledgement[] @relation("AcknowledgementClient")

  adminAuditLogs AdminAuditLog[]
  notifications  Notification[]

  // Consentement CGU — voir TermsAcceptance. Le champ `cgvAcceptedAt` ci-dessus reste la
  // date d'acceptation d'origine ; ce sont les acceptations VERSIONNÉES qui vivent ici.
  termsAcceptances TermsAcceptance[]

  devisRevisions   DevisRevision[] @relation("DevisRevisionAuthor")
  offersAsClient   Offer[]         @relation("OfferClient")
  offersAsProvider Offer[]         @relation("OfferProvider")

  progressCheckpointsValidees ProgressCheckpoint[]
  progressRejectionsPosees    ProgressRejection[]

  frontendReleases FrontendRelease[] @relation("FrontendReleasePublisher")
  reportsFiled     Report[]          @relation("ReportAuthor")
  reportsHandled   Report[]          @relation("ReportHandler")

  @@index([kycStatus])
  @@index([role])
}

// Acceptation des CGU, VERSIONNÉE et chaînée par hash (2026-09-23).
//
// `User.cgvAcceptedAt` ne dit qu'UNE chose : « ce compte a coché la case, à cet instant ».
// C'est insuffisant dès que les CGU changent : impossible de savoir QUELLE version du texte
// a été acceptée, ni d'en produire l'empreinte si elle était contestée. Or une acceptation
// qu'on ne peut pas rattacher au texte accepté ne prouve rien.
//
// Chaque acceptation enregistre donc la version, la date d'entrée en vigueur, l'empreinte du
// texte et un instantané, puis se chaîne à l'acceptation précédente du MÊME utilisateur via
// `computeChainedHash` — le mécanisme déjà utilisé par les déclarations professionnelles et
// les contrats (src/lib/hash-chain.ts), jamais réimplémenté. Une acceptation ne peut donc
// pas être retirée ni réordonnée sans rompre la chaîne, ce que `verifyChainIntegrity` détecte.
//
// Table append-only : aucune route ne met à jour ni ne supprime une ligne ici.
model TermsAcceptance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Version du texte accepté, ex. "3.2" — jamais un booléen.
  termsVersion  String
  // Date d'entrée en vigueur de CETTE version, telle qu'annoncée à l'utilisateur.
  effectiveAt   DateTime
  // SHA-256 du contenu accepté (version + date + URLs), pour comparaison ultérieure.
  digest        String
  // Instantané complet : tout ce qui a été montré et accepté, en clair, sans jointure.
  snapshot      Json
  previousHash  String?
  chainedHash   String
  acceptedAt    DateTime @default(now())

  @@index([userId, acceptedAt])
  @@index([termsVersion])
}

// ---------------------------------------------------------------------------
// Phase 2 — KYC (seule vérification effective, modele-skillafrica-v3-Flexwork.md §9)
// ---------------------------------------------------------------------------

enum KycStatus {
  en_attente
  verifie
  rejete
}

enum OtpChannel {
  sms
  whatsapp
  email
}

enum OtpPurpose {
  signup
  login
  kyc
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String // email ou tel au moment de l'envoi (peut différer du profil si changé depuis)
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

// Compteur anti-spam sur la DEMANDE d'OTP, indépendant de OtpCode/User à dessein : OtpCode
// exige un userId (FK obligatoire), donc un identifiant qui ne correspond à aucun compte n'y
// laisse jamais de ligne. Avant ce modèle, isUnderOtpRequestLimit comptait sur OtpCode et ne
// pouvait donc JAMAIS limiter un identifiant inexistant — 6 requêtes rapides sur le même
// identifiant révélaient son existence par la seule présence d'un 429 (compte réel = fini par
// bloquer, compte inexistant = jamais). Cette table est écrite pour CHAQUE requête de
// /api/auth/login/request-otp, que le compte existe ou non, pour que le rate-limit ne soit
// plus un oracle d'énumération de comptes.
model OtpRequestAttempt {
  id         String   @id @default(cuid())
  identifier String
  // Adresse IP de l'émetteur (x-forwarded-for / x-real-ip, "unknown" si absente) — permet un
  // rate-limit PAR IP en plus de celui par identifiant, pour ne plus être contournable en
  // générant des identifiants uniques. Nullable pour compat avec les lignes pré-migration.
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  // Index autonome sur createdAt pour la purge périodique (deleteMany createdAt < now-window).
  @@index([createdAt])
}

enum KycDocType {
  piece_identite_recto
  piece_identite_verso
  selfie
  selfie_avec_piece
  // Justificatif de domicile (2026-09-23) — appartient au dossier FINANCIER, pas au dossier
  // d'identité. Les quatre types ci-dessus sont les seuls que `deriveKycStatus` regarde pour
  // trancher `User.kycStatus` : sans cette séparation, un justificatif encore en attente
  // ferait retomber un compte déjà « vérifié » à « en attente » sur le dossier d'identité.
  justificatif_domicile
}

enum KycDocStatus {
  en_attente
  verifie
  rejete
}

model KycDocument {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            KycDocType
  filePath        String
  idNumberHash    String?
  status          KycDocStatus @default(en_attente)
  reviewedById    String?
  reviewedBy      User?        @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
  @@index([idNumberHash])
}

// Notifications in-app génériques (dashboard) — jusqu'ici seul MissionNotification existait,
// rattaché obligatoirement à une Mission. Un événement compte (ex. décision KYC) n'a pas de
// missionId : ce modèle générique permet d'afficher un fil "notifications" côté dashboard
// utilisateur, indépendamment de tout doublage par e-mail (src/lib/mail.ts).
// Fil unique de la cloche du navbar (GET /api/notifications) : TOUT événement notifiable y
// arrive — KYC, cycle de vie des missions, messagerie — pour l'acteur comme pour la partie
// adverse (2026-09-09). Avant ce changement la cloche ne montrait que le KYC, les événements
// mission ne vivant que dans MissionNotification (fil « Activité récente » du dashboard).
//
// `type` est passé d'un enum à 2 valeurs à une chaîne applicative libre, même convention que
// MissionNotification.type et Message.type : les libellés d'affichage sont centralisés côté
// application (src/lib/notification-labels.ts), et un nouvel événement n'impose plus de
// migration d'enum.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  // Mission concernée quand l'événement en dépend (mission, jalon, message) — permet de
  // marquer lues les notifications d'une conversation quand son fil est ouvert, et de
  // relier une entrée de la cloche à sa mission. Null pour les événements de compte (KYC).
  missionId String?
  mission   Mission?  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, missionId, readAt])
}

// ── KYC financier (2026-09-23) ──────────────────────────────────────────────────────────
//
// Le schéma ne prévoyait AUCUN moyen d'être payé : ni IBAN, ni Mobile Money, alors que
// l'arbitrage est explicite (« Pas d'IBAN — les paiements passent par PSP Mobile Money »).
// Sans compte de versement, un prestataire pouvait signer, exécuter et voir le séquestre
// validé — et la plateforme n'avait nulle part où envoyer l'argent.
//
// Ce parcours est DISTINCT du KYC d'identité et a son propre statut :
//   - l'identité répond à « qui êtes-vous » (User.kycStatus, 4 documents) ;
//   - le compte de versement répond à « où va l'argent » (PayoutAccount.status).
//
// Les fusionner aurait eu un coût : un justificatif de domicile refusé aurait fait retomber
// un compte pourtant vérifié à « en attente ». Deux dossiers, deux files, deux décisions.
//
// La pièce d'identité n'est PAS redemandée ici : elle a déjà été téléversée au KYC. Ce qui
// est propre au dossier financier, c'est le compte de versement et le justificatif de
// domicile.
enum MobileMoneyOperator {
  mtn
  moov
  celtiis
}

enum PayoutStatus {
  non_renseigne
  en_attente
  verifie
  rejete
}

model PayoutAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  operator MobileMoneyOperator
  // Numéro au format international (+229…). Jamais normalisé en base : c'est le numéro que
  // l'opérateur reconnaîtra, et le reformater risquerait de casser un préfixe local.
  number   String
  // Le titulaire est saisi et non déduit du compte : un prestataire peut être payé sur le
  // compte d'un tiers (conjoint, entreprise), et cette différence doit être visible par
  // l'Admin KYC au moment d'instruire — un nom qui ne correspond pas à la pièce d'identité
  // est un signal, pas une erreur de saisie.
  holder   String

  // Justificatif de domicile, dans le bucket privé (KycDocument de type
  // `justificatif_domicile`). Référence et non chemin : le fichier est servi par URL signée,
  // comme les autres pièces, et l'Admin le valide dans le même écran.
  addressProofDocId String?

  status          PayoutStatus @default(en_attente)
  submittedAt     DateTime     @default(now())
  reviewedById    String?
  reviewedBy      User?        @relation("PayoutReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  refusalReason   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, submittedAt])
}

model LivenessCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passed    Boolean
  provider  String   @default("stub")
  metadata  Json?
  createdAt DateTime @default(now())
}

model SelfieMatchLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context    String
  similarity Float
  passed     Boolean
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// A13 — Contrôle d'âge sur les filières chantier (etat-consolide-Flexwork.md §2, A13)
// Deuxième exception au principe déclaratif (après l'assurance sur le risque élevé, A9) :
// une VÉRIFICATION EFFECTIVE par la plateforme, pas une déclaration. Seuil administrable
// par pays, jamais en dessous de 18 ans — contrainte imposée côté application
// (src/lib/age-gate.ts), pas seulement une convention d'usage.
// ---------------------------------------------------------------------------

model CountryAgeRequirement {
  id             String   @id @default(cuid())
  country        String
  profileType    UserRole // artisan | manoeuvre | expert_btp_autres uniquement (validé en app)
  domain         String? // règle spécifique à un domaine (ex. conduite d'engins)
  minimumAge     Int // >= 18, refusé sinon (src/lib/age-gate.ts::isValidMinimumAge)
  legalReference String?
  setByAdminId   String
  justification  String
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([country, profileType, domain])
}

// ---------------------------------------------------------------------------
// Phase 3 — Déclarations professionnelles (modele-skillafrica-v3-Flexwork.md §4-5)
// ---------------------------------------------------------------------------

enum ProfessionalLevel {
  debutant
  intermediaire
  senior
  expert
}

// Forme juridique déclarée du prestataire (onglet 1). Déclaratif, sans effet sur les droits :
// un compte « entreprise » n'a pas plus de pouvoir qu'un indépendant, il se présente
// simplement autrement. Le distinguer de `UserRole` est nécessaire : une entreprise de
// plomberie reste un `artisan` au sens de la filière, et la filière décide des missions
// proposées, pas la forme juridique.
enum ProviderKind {
  independant
  entreprise
  artisan
  manoeuvre
}

// Modes de travail acceptés par le prestataire (onglet 4). Alignés sur `Mission.mode`
// (distance | presentiel | hybride) pour que le filtre « ce prestataire peut-il prendre cette
// mission » se lise sans table de correspondance.
enum WorkMode {
  presentiel
  distance
  hybride
}

enum Availability {
  temps_plein
  temps_partiel
  ponctuel
  indisponible
}

// Profil générique unique (remplace ArtisanProfile/ExpertProfile/ManoeuvreProfile/
// DigitalProfile) — la plateforme ne vérifie plus rien ici, tout est auto-déclaré (A4).
model Profile {
  id                      String             @id @default(cuid())
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                   String             @default("Principal") // Nom du profil (ex: "Maçon local", "Conseil BTP distance")
  isDefault               Boolean            @default(false)
  mainDomain              String
  // Inutilisée depuis le 2026-09-23 : la « Spécialité » était un texte libre qui redisait le
  // métier en concurrence avec les compétences, que le catalogue décrit précisément. Aucun
  // écran ni barème ne la lit plus. Colonne conservée, comme `users.passwordHash`, pour ne
  // détruire aucune donnée existante — et non par oubli.
  subSpecialty            String?
  // ── Lien vers la taxonomie (2026-09-23) ──────────────────────────────────────────────────
  // `mainDomain` porte le LIBELLÉ du métier — c'est lui qui sert au rapprochement, exactement
  // comme `Mission.domaine`. Mais un libellé ne dit pas de quelle CATÉGORIE il vient : à la
  // réédition, la cascade se rouvrait vide et le profil ne pouvait plus être reclassé
  // proprement. La clé étrangère répare ça, sur le même principe que les missions : la FK fait
  // foi, le texte reste sa projection. Nullable — les profils antérieurs n'ont que le libellé,
  // et aucun backfill ne peut inventer le métier d'où il venait.
  metierId                String?
  metier                  Metier?            @relation(fields: [metierId], references: [id])
  secondaryDomain         String?
  sector                  String?
  indicativeRate          Float?
  declaredExperienceYears Int?
  declaredLevel           ProfessionalLevel?
  tags                    String[] // Compétences déclarées (ex: "Soudure", "Placo", "Plomberie")
  // Profil enrichi 2026-08-06 : zone d'intervention, tarification, description, portfolio.
  description             String? // Texte libre de présentation (bio, expérience, méthodes)
  portfolioUrls           String[] // URLs de travaux/réalisations (photos, liens) — relPaths
  // de photos téléversées OU URLs externes
  cvUrl                   String? // CV téléversé (relPath stockage), servi via /api/files/[token]
  tarifUnite              String? // heure | jour | semaine | mois | mission
  zonePays                String? // Pays d'intervention (BJ, CI, SN...)
  zoneVille               String? // Ville principale
  zoneRayonKm             Int? // Rayon de déplacement en km (null = sans limite)

  // ── Profil professionnel progressif (2026-09-23) ────────────────────────────────────────
  // Champs des onglets 1, 4 et 5 du formulaire prestataire. Ils ne créent AUCUNE table
  // `provider_*` : le schéma avait déjà de quoi porter chaque onglet (voir le mapping dans
  // src/lib/provider-profile-completion.ts), et dupliquer `Profile` en `ProviderProfile`
  // aurait ouvert deux sources de vérité pour le même métier.

  // Onglet 1 — Présentation. `title` est le titre affiché sur les cartes (« Électricien
  // certifié »), distinct de `mainDomain` qui porte le MÉTIER du catalogue : le premier est
  // une accroche libre, le second une clé de rapprochement. Les confondre rendrait le
  // rapprochement dépendant de la façon dont chacun se présente.
  title        String?       @db.VarChar(120)
  providerKind ProviderKind?

  // Onglet 2 — Compétences proposées : tout passe par `tags`, la seule liste de compétences du
  // profil, qu'elles viennent du catalogue du métier ou qu'elles aient été ajoutées à la main.
  //
  // `offeredServices` portait une SECONDE liste, sous le nom de « services proposés » : deux
  // façons de déclarer la même chose, donc deux façons de diverger, et deux barèmes à tenir.
  // Elle n'est plus alimentée depuis le 2026-09-23. Colonne conservée, comme
  // `users.passwordHash`, pour ne détruire aucune donnée existante — et non par oubli.
  offeredServices String[]

  // Onglet 4 — Localisation. Modes de travail et zones couvertes s'ajoutent au trio
  // zonePays/zoneVille/zoneRayonKm déjà présent ; `availability` est la disponibilité
  // déclarée, jamais un engagement (le profil ne bloque rien, §9).
  workModes      WorkMode[]
  coverageZones  String[]
  availability   Availability?
  // ── Champs alignés sur le formulaire prestataire du modèle (2026-09-23) ───────────────
  // `overview` est le SECOND texte long, distinct de `description` : le modèle demande une
  // bio courte (≥ 100 caractères) pour les cartes ET un développement (≥ 500) pour le profil
  // abouti. Un seul champ ne peut pas servir les deux — court partout, il ne dit rien sur la
  // page ; long partout, il noie les cartes où on le tronque.
  overview       String?
  // Complément de `zoneVille` : le quartier précise la zone à l'échelle où les interventions
  // se situent réellement — on ne traverse pas une ville pour un dépannage.
  quartier       String?
  // Moyens de déplacement déclarés (moto / voiture / à pied). Même convention que
  // `workModes` et `coverageZones` : une liste de valeurs DÉCLARATIVES, jamais un droit.
  deplacement    String[]
  // Canal de contact préféré. Valeurs dans src/lib/provider-options.ts, comme `tarifUnite`.
  modeContact    String?

  // Onglet 5 — Configuration. Devise de facturation, pendant prestataire de
  // `ClientProfile.currency`. Défaut XOF : la zone couverte par la plateforme.
  currency String @default("XOF")

  // Langues parlées (2026-11-08) — biographie du profil : [{ "code": "fr", "niveau": "natif" }].
  // Codes ISO 639-1, niveaux débutant / intermédiaire / courant / natif (src/lib/languages.ts).
  languages Json @default("[]")

  // Badge « Vérifié » (2026-09-23) : demandé par le prestataire, instruit par l'Admin KYC.
  // Porté par le PROFIL et non par le compte : un prestataire multi-profils peut être vérifié
  // sur son métier principal sans l'être sur un second qu'il vient d'ouvrir.
  badgeStatus       BadgeStatus @default(non_demande)
  badgeRequestedAt  DateTime?
  badgeDecidedAt    DateTime?
  badgeRefusalReason String?

  garants      Garant[]
  declarations ProfessionalDeclaration[]

  @@unique([userId, label])
  @@index([userId])
  @@index([mainDomain])
}

// Pièce jointe déposée AVANT que la mission existe (2026-09-23) — cahier des charges, plans,
// photos, joints dès la première étape du tunnel de création.
//
// Table distincte de `MissionAttachment` plutôt que d'y rendre `missionId` nullable : ce
// champ non nul est ce qui garantit qu'aucune pièce jointe ne flotte sans mission, et
// l'affaiblir pour un cas transitoire coûterait cette garantie partout ailleurs.
//
// `POST /api/missions/[id]/attachments` ne pouvait pas servir ici : il exige une mission déjà
// acceptée (`canAttachLivrable`), règle anti-travail-test gratuit US-1302.
//
// `draftId` est produit par le navigateur et n'identifie personne : l'appartenance est
// tranchée par `uploaderId`, jamais par lui. Les lignes sont converties en
// `MissionAttachment` à la création de la mission, puis supprimées.
model MissionDraftAttachment {
  id         String   @id @default(cuid())
  draftId    String
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filePath   String
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([uploaderId, draftId])
}

// Qui fournit le matériel d'une mission (2026-09-23) — déclaratif, sans effet sur le contrat
// ni sur le séquestre : c'est une attente annoncée au prestataire avant qu'il chiffre.
enum MaterielFourniture {
  client
  prestataire
  mixte
}

enum ClientType {
  particulier
  entreprise
  association
  administration
}

// Profil client (2026-09-23) — symétrique de Profile, qu'il ne remplace pas. Les deux
// coexistent : un compte qui change de rôle garde le profil de l'autre côté intact, et
// `Profile.mainDomain` garde sa contrainte (un profil prestataire a toujours un domaine).
//
// Ce qui n'est PAS ici : la photo et l'adresse. Elles vivent déjà sur User (avatarPath,
// address, city, country, locality) et servent aux deux rôles ; les dupliquer ouvrirait
// deux sources de vérité pour la même information.
//
// Comme le profil prestataire, tout est déclaratif : la plateforme ne vérifie rien ici et
// ne conditionne aucun droit à sa complétion (modele-skillafrica-v3-Flexwork.md §9 — le
// profil ne bloque jamais, seul le KYC garde des actions précises).
model ClientProfile {
  id         String      @id @default(cuid())
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession String?
  clientType ClientType?
  company    String? // Renseigné pour entreprise/association/administration
  sector     String? // Secteur de l'organisation — PAS la taxonomie métier, qui décrit le
  // travail demandé, pas l'activité du donneur d'ordre.
  languages  String[] // Langues de travail déclarées
  currency   String      @default("XOF")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum DeclarationType {
  insurance
  qualification
  // Ajouté le 2026-09-23. Le formulaire /declarations postait déjà `declarationType:
  // "experience"` — l'enum ne le connaissait pas, zod refusait, et CHAQUE envoi d'expérience
  // repartait en 400 sous un message « Échec de l'enregistrement » que rien n'expliquait.
  experience
}

// Statut de la demande de badge « Vérifié » (2026-09-23).
//
// Le bouton existait et appelait POST /api/declarations/badge — une route qui n'existait pas.
// Chaque clic repartait en 404 et affichait « Échec — complétez toutes les sections », un
// message qui accusait le prestataire d'un tort qui n'était pas le sien.
enum BadgeStatus {
  non_demande
  en_attente
  accorde
  refuse
}

// Diplôme déclaré, rattaché à la déclaration qui le porte (2026-09-23).
//
// Adossé à ProfessionalDeclaration et non au profil : la déclaration est append-only et
// chaînée par hash, c'est elle qui date et scelle ce qui a été affirmé. Un diplôme corrigé
// donne une nouvelle déclaration, l'ancienne reste consultable — même règle que le reste.
//
// Ces champs étaient saisis par /declarations puis SILENCIEUSEMENT jetés : `declarationSchema`
// ne les déclarait pas, zod les supprimait, et l'écran annonçait malgré tout « Qualifications
// enregistrées et horodatées ». Le schéma dit pourtant que « le diplôme d'État est le pivot
// du badge » — ce pivot n'était stocké nulle part.
model DeclaredDiploma {
  id                String                  @id @default(cuid())
  declarationId     String
  declaration       ProfessionalDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  qualificationName String
  year              Int?
  location          String?
  institution       String?
  specialty         String?
  // Pays d'obtention (2026-11-07) — code ISO 3166-1 alpha-2, comme User.country. Distinct de
  // `location` (« établissement, ville » sur /declarations) : un pays n'est pas un lieu libre.
  country           String?
  // Pivot du badge : un diplôme d'État vaut vérification, un diplôme déclaratif ne vaut que
  // ce que son auteur en dit.
  isStateIssued     Boolean                 @default(false)
  createdAt         DateTime                @default(now())

  @@index([declarationId])
}

// Expérience professionnelle déclarée (2026-09-23), même logique d'adossement.
// Les dates sont des chaînes « AAAA-MM » : le formulaire utilise <input type="month">, et
// convertir en date complète inventerait un jour qui n'a pas été saisi.
model DeclaredExperience {
  id            String                  @id @default(cuid())
  declarationId String
  declaration   ProfessionalDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  clientType    String // INDIVIDUAL | COMPANY
  clientName    String?
  role          String
  domain        String?
  description   String?
  startDate     String?
  endDate       String?
  technologies  String?
  projectUrl    String?
  livrables     String?
  createdAt     DateTime                @default(now())
  references    DeclaredReference[]

  @@index([declarationId])
}

// Personne ressource attestant d'une expérience — rattachée à l'expérience qu'elle atteste,
// jamais à la déclaration en vrac : sans ce lien, « qui confirme quoi » serait perdu.
model DeclaredReference {
  id           String             @id @default(cuid())
  experienceId String
  experience   DeclaredExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  kind         String // primary | secondary | cross
  nom          String
  prenom       String?
  tel          String?
  email        String?
  lien         String?
  createdAt    DateTime           @default(now())

  @@index([experienceId])
}

// Append-only, chaîné par hash (modele-skillafrica-v3-Flexwork.md §4.2) — jamais de
// UPDATE/DELETE exposé. Une correction crée une nouvelle déclaration ; l'ancienne reste
// consultable. Voir src/lib/declaration-chain.ts pour le calcul du hash.
model ProfessionalDeclaration {
  id                      String          @id @default(cuid())
  profileId               String
  profile                 Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  declarationType         DeclarationType
  label                   String? // ex. "CQP Plomberie" pour une qualification
  insurerName             String?
  policyNumber            String?
  coverageCeiling         Float?
  validUntil              DateTime?
  declaredAt              DateTime        @default(now())
  diplomas                DeclaredDiploma[]
  experiences             DeclaredExperience[]
  declarationTextSnapshot String
  ipAddress               String?
  userAgent               String?
  previousHash            String?
  currentHash             String          @unique
  // Retrait par modération (US-306) — métadonnée de visibilité, jamais un UPDATE/DELETE
  // du contenu chaîné : la déclaration reste dans la chaîne de hash pour l'intégrité de
  // l'historique, mais n'apparaît plus dans les listes publiques une fois retirée.
  removedAt               DateTime?
  removedReason           String?

  documents DeclarationDocument[]

  @@index([profileId, declarationType, declaredAt])
}

model DeclarationDocument {
  id            String                  @id @default(cuid())
  declarationId String
  declaration   ProfessionalDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  filePath      String
  fileName      String
  createdAt     DateTime                @default(now())
}

enum ReferenceAppelStatus {
  a_appeler
  confirme
  injoignable
}

// 1 obligatoire + 2 optionnelles (etat-consolide-Flexwork.md §1.3) — cardinalité contrôlée
// côté application (src/lib/garant-rules.ts), pas en base.
model Garant {
  id          String               @id @default(cuid())
  profileId   String
  profile     Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  obligatoire Boolean              @default(false)
  nom         String
  tel         String
  statutAppel ReferenceAppelStatus @default(a_appeler)
  createdAt   DateTime             @default(now())

  @@index([tel])
}

// ---------------------------------------------------------------------------
// Phase 4 — Missions & contrat de prestation
// ---------------------------------------------------------------------------

enum MissionMode {
  distance
  presentiel
  hybride
}

// Secteur de la marketplace (2026-09-28) — voir `Categorie.secteur`.
enum Secteur {
  digital
  btp
  services
}

enum RiskLevel {
  low
  medium
  high
}

// modele-skillafrica-v3-Flexwork.md §7.2 — insuranceRequired = true uniquement pour high,
// jamais configurable à false pour ce palier (garde-fou métier, voir US-701/702).
//
// RETIRÉE DE L'USAGE le 2026-09-23 : le palier de risque vit maintenant sur `Metier.riskLevel`,
// saisi par l'administrateur dans la taxonomie. Cette table indexait le risque sur un libellé
// LIBRE (`domain`) + un pays, et ses 4 lignes « high » ne correspondaient à aucun métier du
// catalogue — le risque déclaré y était donc, en pratique, inexistant (4 métiers sur 220, aucun
// palier atteignable au-delà de `medium`). Table conservée, comme `users.passwordHash`, pour ne
// détruire aucune donnée : plus rien ne la lit ni ne l'écrit.
model DomainRiskLevel {
  id                String    @id @default(cuid())
  domain            String
  country           String
  riskLevel         RiskLevel
  insuranceRequired Boolean
  amountThreshold   Float?
  justification     String?

  @@unique([domain, country])
}

// Cycle court aligné sur modele-skillafrica-v3-Flexwork.md §6.3, en remplacement du Kanban
// à 16 statuts (couplé à l'ancien escrow interne, sans équivalent dans le modèle v3).
enum MissionStatus {
  brouillon
  publiee
  proposition_acceptee
  contrat_genere
  contrat_signe
  fonds_sous_sequestre
  en_cours
  livrable_soumis
  validee
  cloturee
  mediation_ouverte
  // Reliquat du séquestre rendu au client (2026-09-14, voir emitContractRefund,
  // src/lib/escrow.ts). Un état DÉDIÉ, et non `cloturee` : une mission remboursée n'est pas une
  // mission menée à terme, et les confondre ferait passer un abandon pour une réussite dans
  // tout ce qui compte les missions closes — dashboards, historique, réputation. La branche
  // `refund` de applyPspWebhookEvent (src/lib/psp-webhook.ts) réclamait cet état depuis qu'elle
  // existe, en refusant justement d'en inventer un.
  remboursee
}

model Mission {
  id                String        @id @default(cuid())
  clientId          String
  client            User          @relation("MissionClient", fields: [clientId], references: [id], onDelete: Cascade)
  titre             String
  description       String
  // Libellé du domaine, conservé (2026-09-23) alors même que `metier` le porte désormais en
  // clé étrangère. Ce n'est PAS une redondance oubliée : `src/lib/domain-match.ts` rapproche
  // les missions des prestataires en comparant ce texte à `Profile.mainDomain`, lui aussi
  // libre. Tant que le profil prestataire n'est pas lui-même rattaché à la taxonomie, couper
  // ce champ couperait le rapprochement. Il est donc SYNCHRONISÉ depuis le métier choisi
  // (voir POST /api/missions) : la FK fait foi, le texte suit.
  domaine           String
  // ── Taxonomie (2026-09-23) : Catégorie → Métier → Compétences ─────────────────────────
  // Nullable : les missions publiées avant cette date n'ont que `domaine`. Les compétences
  // ne sont pas une troisième FK mais les `tags` ci-dessous, remplis depuis les libellés de
  // `Service` — `Profile.tags` les compare déjà par `hasSome`, ce qui rend le rapprochement
  // par compétence opérant dès que les deux côtés puisent dans le même catalogue.
  categorieId       String?
  categorie         Categorie?    @relation(fields: [categorieId], references: [id])
  metierId          String?
  metier            Metier?       @relation(fields: [metierId], references: [id])
  mode              MissionMode   @default(presentiel)
  // ── Cadrage (2026-09-23) ──────────────────────────────────────────────────────────────
  // Le formulaire saisissait déjà une date de début, mais ne gardait que `delaiJours` qui en
  // dérive : la date elle-même était jetée après le calcul.
  dateDebut         DateTime?
  pays              String? // Code ISO 2 lettres, comme User.country
  ville             String?
  quartier          String?
  urgent            Boolean       @default(false)
  materiel          MaterielFourniture?
  // Complément libre à la description : plans, contraintes, attendus détaillés. Les FICHIERS
  // du cahier des charges attendent leur propre endpoint (celui des pièces jointes existantes
  // exige une mission acceptée — règle anti-travail-test gratuit US-1302).
  cahierDesCharges  String?
  // Fourchette indicative, réservée au mode devis (budgetType = "QUOTE") où aucun montant
  // ferme n'est fixé. Distincte de `budget`, qui reste le prix du contrat quand aucun devis
  // ne le remplace — une fourchette ne peut pas jouer ce rôle.
  budgetMin         Int?
  budgetMax         Int?
  // Plafond de candidatures. `null` = illimité.
  maxCandidatures   Int?
  budget            Float
  currency          String        @default("XOF")
  delaiJours        Int
  riskLevel         RiskLevel     @default(low)
  insuranceRequired Boolean       @default(false)
  // Quick win 2026-08-06 : champs saisis dans /missions/new mais jusqu'ici silencieusement
  // jetés par Zod (missionSchema ne les déclarait pas, Mission n'avait pas ces colonnes).
  professionalType  String? // EXPERT_DIGITAL | EXPERT_BTP | ARTISAN | MANOEUVRE
  requiredLevel     String? // Débutant | Junior | Intermédiaire | Senior | Expert
  budgetType        String? // FIXED | RATE | QUOTE — "QUOTE" EST le mode devis (pas de booléen redondant)
  // Mode de financement choisi par le CLIENT à la PUBLICATION (2026-09-10) : F2, F3, J1, J2, J3
  // — clé du catalogue src/lib/financing-modes.ts, jamais un enum Prisma (même convention que
  // budgetType/professionalType ci-dessus : le catalogue porte le libellé, le badge, la
  // disponibilité et la stratégie de dérivation, tout cela évolue sans migration).
  //
  // Pourquoi à la publication et pas à la génération du contrat : le mode dit au prestataire
  // COMMENT chiffrer. Un mode « jalons pondérés » attend un devis découpé en postes livrables
  // un à un ; un mode « escrow upfront » attend un forfait. L'annoncer après la négociation
  // arrivait trop tard. Modifiable tant qu'aucun contrat n'est généré
  // (PATCH /api/missions/[id]/financing-mode), figé ensuite dans le contrat.
  //
  // Nullable : les missions publiées avant cette date n'en ont pas — la génération de contrat
  // retombe alors sur les jalons saisis à la main, comportement historique inchangé.
  //
  // RÈGLE ACTUELLE (2026-10-01) : fixe ou par jalons, c'est le DEVIS qui le fixe
  // (MissionProposal.devisData.financingModeKey, choisi par le prestataire, accepté par le
  // client). Cette colonne ne porte plus qu'un mode au TEMPS (S2*) ; une valeur fixe/jalons n'y
  // subsiste que sur les missions antérieures, comme repli (effectiveFinancingModeKey).
  financingModeKey  String?
  // Conditions d'un contrat au TEMPS (modes S2, 2026-09-15), posées par le client à la
  // publication : un tarif indicatif par unité et une quantité maximale (20 jours, 200 heures…).
  // L'unité elle-même vient du mode (S2H/S2J/S2M), jamais d'une colonne. Le budget publié en
  // découle (`timeRate × timeMaxQuantity`) : c'est le plafond que le client séquestrera.
  // Nulles hors S2. Sans elles, aucun contrat au temps ne pouvait naître : les relevés de présence
  // exigent des conditions tarifaires que rien, avant ce correctif, ne savait produire.
  timeRate          Float?
  timeMaxQuantity   Float?
  // Mode de pointage (2026-10-01) : règle de validation des relevés de présence, posée par le
  // CLIENT à la publication d'une mission au temps, comme le tarif et le plafond. « totale » :
  // un relevé se valide en entier ou se refuse/conteste ; « partielle » : le validateur peut
  // n'en reconnaître qu'une partie. Null hors S2. Recopié et FIGÉ dans SpotTimeTerms au contrat.
  // Ne touche pas l'outil de pointage horodaté (CheckInEvent, règle A12) : il reste facultatif
  // et soumis au consentement des deux parties.
  attendanceValidation AttendanceValidation?
  // Vérification / validation (2026-10-01), choisie par le CLIENT à la publication, pour tout
  // type de mission :
  //   - "client" (« Moi-même ») : le client constate les relevés et valide jalons/tâches seul.
  //   - "opr" (« OPR / responsable chantier ») : un responsable de chantier désigné constate les
  //     relevés et vérifie jalons/tâches (preuves, avancement), puis TRANSMET au client, qui seul
  //     prononce la validation définitive — et donc la libération des fonds.
  // Figé au contrat (PrestationContract.validationMode).
  validationMode       ValidationMode @default(client)
  // Responsable désigné dès la publication (facultatif — il peut l'être plus tard, sur le
  // contrat). Recopié au contrat à sa génération.
  siteManagerId        String?
  siteManager          User?          @relation("MissionSiteManager", fields: [siteManagerId], references: [id], onDelete: SetNull)
  tags              String[] // Compétences requises (ex: "Soudure", "Placo", "Électricité BT")
  status            MissionStatus @default(brouillon)
  // ── Publication demandée avant vérification d'identité (2026-10-06) ───────────────────
  // Le client a cliqué « Publier » alors que son KYC n'était pas vérifié : la mission est
  // enregistrée en BROUILLON (rien n'est perdu) et marquée ici. Dès la vérification, il est
  // notifié et peut la publier en un clic (POST /api/missions/[id]/publish), qui remet ce
  // champ à null. `null` = brouillon ordinaire, ou mission déjà publiée.
  publicationRequestedAt DateTime?

  // Progression du livrable — contrat SANS jalon uniquement (pendant, au niveau mission, de
  // Jalon.declaredProgress/observedProgress ; un contrat à jalons suit la progression
  // jalon par jalon, pas ici). 0-100, déclarative — jamais de libération basée dessus seule
  // (canSubmitDeliverable reste le garde de statut réel). Bornage 0-100 appliqué côté route,
  // pas en contrainte DB. Remis à 0 au rejet (POST .../escrow/reject) — nouveau cycle, comme
  // pour un jalon.
  declaredProgress Int       @default(0) // renseigné par le prestataire
  observedProgress Int       @default(0) // renseigné par le client — gate la validation (release)
  // Pendant, au niveau MISSION ENTIÈRE (contrat sans jalon), de Jalon.reviewOpenedAt — voir ce
  // champ pour le rationale complet. Posé par POST .../deliverable/review-open, remis à null à
  // chaque nouvelle bascule vers `livrable_soumis` (voir .../deliverable/submit).
  reviewOpenedAt   DateTime?
  // Pendant, au niveau MISSION ENTIÈRE (contrat sans jalon), de Jalon.submittedAt — voir ce
  // champ pour le rationale complet. Point de départ du délai d'acceptation tacite.
  submittedAt      DateTime?
  // Pendant, au niveau MISSION ENTIÈRE (contrat sans jalon), de Jalon.verifiedAt : transmission
  // du responsable de chantier au client en mode OPR. Remis à null à chaque nouvelle soumission.
  verifiedAt       DateTime?
  verifiedById     String?
  verificationNote String?
  // Pendant de Jalon.clientValidatedById/At pour un contrat sans jalon.
  clientValidatedById String?
  clientValidatedAt   DateTime?

  // ── Mode devis BTP (négociation multi-round) ──────────────────────────
  maxRevisionRounds Int       @default(3) // rounds de négociation autorisés
  dateExpiration    DateTime? // échéance de candidature/devis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals           MissionProposal[]
  offers              Offer[]
  notifications       MissionNotification[]
  bellNotifications   Notification[]
  attachments         MissionAttachment[]
  messages            Message[]
  reviews             Review[]
  contract            PrestationContract?
  insurance           MissionInsurance?
  acknowledgements    ClientAcknowledgement[]
  progressCheckpoints ProgressCheckpoint[]
  progressRejections  ProgressRejection[]

  @@index([status])
  @@index([domaine])
}

enum ProposalStatus {
  envoyee // candidature envoyée (pending)
  preselectionnee // shortlisté par le client (shortlisted)
  en_negociation // devis en discussion
  devis_valide // devis validé, en attente de génération de contrat
  acceptee // sélection finale (existante — déclenche le contrat)
  refusee // refusée (existante)
  annulee_definitive // négociation annulée (rounds max ou expiration)
}

// Remplace l'ancien Devis (montant unique, sans jalons ni mode BTP — le cycle v3 §6.3 ne
// décrit pas de paiement fractionné par jalon, uniquement HOLD -> RELEASE par mission).
// Mode devis BTP : `montant` est mis à jour à chaque soumission (= totalTTC), la
// négociation est tracée par round (`roundActuel`, `devisData`) et l'historique est
// conservé dans DevisRevision (append-only).
model MissionProposal {
  id           String         @id @default(cuid())
  missionId    String
  mission      Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User           @relation("ProposalProvider", fields: [providerId], references: [id], onDelete: Cascade)
  montant      Float          @default(0)
  // Contre-proposition du prestataire : délai (en jours) qu'il s'engage à tenir. Le contrat
  // doit être basé sur CE délai (et ce prix), pas sur ceux initialement publiés par le client
  // — sinon la négociation (étape 2 du workflow) n'a aucun effet contractuel. Nullable : les
  // candidatures antérieures n'en ont pas (le contrat retombe alors sur mission.delaiJours).
  delaiPropose Int?
  // Tarif par unité proposé par le prestataire sur une mission au TEMPS (S2). `montant` reste le
  // prix du contrat — ici le plafond, `unitRate × Mission.timeMaxQuantity` — parce que c'est lui
  // que le séquestre, le contrat et toute la chaîne monétaire lisent déjà. Nul hors S2.
  unitRate     Float?
  message      String?
  status       ProposalStatus @default(envoyee)

  // ── Négociation de devis ─────────────────────────────────────────────
  roundActuel            Int       @default(0)
  devisData              Json? // { lineItems[], totalHT, tva, totalTTC, delay, notes }
  devisValideAt          DateTime?
  // Le prestataire ne peut resoumettre un devis déjà soumis (round >= 1) que si le client a
  // explicitement demandé une révision — POST .../devis/request-revision. Consommé (remis à
  // null) dès que le prestataire soumet la révision demandée (POST /api/missions/[id]/devis).
  revisionRequestedAt    DateTime?
  revisionRequestMessage String?
  // Motif obligatoire du rejet explicite d'un devis par le client — POST
  // .../devis/reject. Distinct de "refusee" posé en effet de bord de l'acceptation d'UNE
  // AUTRE proposition (là, aucun motif n'est saisi par le client, ce n'est pas son geste).
  devisRejectedAt        DateTime?
  devisRejectionReason   String?

  // Pas de `updatedAt` : l'historique des changements de devis est déjà porté par
  // DevisRevision (append-only) — inutile de le dupliquer ici.
  createdAt DateTime @default(now())

  revisions DevisRevision[]
  offers    Offer[]

  @@unique([missionId, providerId])
  @@index([missionId, status])
  @@index([providerId, status])
}

// Historique append-only des rounds de négociation d'un devis. Chaque soumission/counter
// crée une nouvelle révision ; la précédente reste consultable (même principe que
// ProfessionalDeclaration / ContractAuditEntry : jamais d'UPDATE du contenu).
model DevisRevision {
  id          String          @id @default(cuid())
  proposalId  String
  proposal    MissionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  roundNumber Int
  authorId    String
  author      User            @relation("DevisRevisionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  devisData   Json // snapshot immuable du devis à ce round
  comment     String?
  createdAt   DateTime        @default(now())

  @@index([proposalId, roundNumber])
}

// Offres directes client → prestataire (invitation hors candidature).
// Les postes pré-contractuels sont stockés en JSON (pas de modèle dédié) pour ne pas
// dupliquer `Jalon` : une fois l'offre acceptée, le contrat est généré et les postes
// deviennent des `Jalon` existants.
enum OfferStatus {
  brouillon
  envoyee
  acceptee
  refusee
  expiree
  annulee
}

model Offer {
  id          String           @id @default(cuid())
  missionId   String
  mission     Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  clientId    String
  client      User             @relation("OfferClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId  String
  provider    User             @relation("OfferProvider", fields: [providerId], references: [id], onDelete: Cascade)
  proposalId  String?
  proposal    MissionProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  titre       String
  description String
  montant     Float
  currency    String           @default("XOF")
  milestones  Json? // [{ ordre, description, unite, montant }]
  status      OfferStatus      @default(brouillon)
  sentAt      DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([providerId, status])
  @@index([missionId])
}

model MissionNotification {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   @default("stub")
  // Type d'événement mission (valeurs applicatives, même convention que Message.type) :
  //   mission_match      → nouvelle mission correspondant au profil (historique, matching)
  //   contract_generated → contrat généré, le prestataire doit signer (« mission à confirmer »)
  //   provider_signed    → le prestataire a signé, le client doit contre-signer sous 48h
  //   contract_locked    → les 2 signatures sont apposées, la mission est engagée
  //   contract_expired   → délai 48h dépassé sans contre-signature, contrat annulé
  type      String   @default("mission_match")
  // Message libre affiché dans le fil « Activité récente » du dashboard (fallback au type
  // quand absent, comme l'historique qui reconstruit le libellé depuis le titre de mission).
  message   String?
  createdAt DateTime @default(now())

  @@index([missionId])
  @@index([userId, createdAt])
}

model MissionAttachment {
  id              String    @id @default(cuid())
  missionId       String
  mission         Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  // Rattache optionnellement une pièce jointe à un jalon précis (livrable soumis pour CE
  // jalon) — null pour les pièces jointes génériques (cahier des charges) ou pour les
  // missions sans jalon (livrable unique de la mission entière).
  jalonId         String?
  jalon           Jalon?    @relation(fields: [jalonId], references: [id], onDelete: Cascade)
  uploaderId      String
  filePath        String
  // Type MIME réel du fichier (ex. "image/jpeg", "application/pdf") — même convention que
  // Message.mimeType. Null pour les entrées texte-seules (preuves "geolocation"/"other" sans
  // fichier, préfixe filePath "__no_file__/…") et pour les anciennes pièces jointes créées
  // avant ce champ. Permet à GET /api/files/[token] de servir le bon Content-Type et de
  // décider de l'affichage inline (image/vidéo/PDF) plutôt qu'un téléchargement forcé —
  // sans lui, le client ne pouvait pas RELIRE une preuve dans la modale de validation,
  // seulement la télécharger à l'aveugle (2026-09-03).
  mimeType        String?
  // Type de preuve pour un livrable scopé-jalon (photo|video|document|geolocation|other) —
  // valeurs applicatives, pas un enum Prisma (même convention que Message.type). Null pour
  // les pièces jointes génériques hors jalon (comportement historique inchangé).
  category        String?
  // Légende libre, ou coordonnées réelles "lat,long" capturées via navigator.geolocation
  // côté client pour category === "geolocation" (jamais de coordonnées inventées).
  note            String?
  // Appréciation du CLIENT sur CETTE preuve (2026-09-05, maquette "Appréciation des preuves") :
  // null = en attente ; "validee" = le client a validé la preuve ; "rejetee" = le client l'a
  // rejetée (raison + motif + demande éventuelle d'une nouvelle preuve). L'appréciation rend
  // la preuve IMMUABLE (le prestataire ne peut plus la retirer). Le % global de progression
  // reste porté par Mission/Jalon.observedProgress (curseur client), PAS recalculé ici :
  // l'appréciation par preuve est une PRÉ-VALIDATION qui conditionne la validation finale
  // (chaque preuve du lot courant doit être validée avant "Valider ce point d'étape" /
  // "Valider — libérer" — garde côté route).
  appreciation    String?
  rejectionReason String? // raison choisie dans la liste prédéfinie (libellé)
  rejectionMotif  String? // motif détaillé libre (≥ 20 caractères)
  requestNewProof Boolean   @default(false) // "Demander une nouvelle preuve" au rejet
  appreciatedById String? // id du client ayant apprécié (trace)
  appreciatedAt   DateTime?
  createdAt       DateTime  @default(now())

  @@index([missionId])
  @@index([jalonId])
}

model Message {
  id             String   @id @default(cuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           String   @default("text") // "text" | "file"
  fileName       String?
  filePath       String?
  fileSize       Int?
  mimeType       String?
  flaggedLeakage Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([missionId, createdAt])
}

// US-406 (héritée) : avis 1 à 5. `suspendu` reflète désormais une médiation ouverte au
// moment de la publication (voir Mediation), plus un ancien champ litigeActif supprimé.
model Review {
  id          String   @id @default(cuid())
  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId    String
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  note        Int
  commentaire String?
  suspendu    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([missionId, authorId])
  @@index([targetId])
}

// Contenu minimal imposé — modele-skillafrica-v3-Flexwork.md §2.1. Aucun champ
// `platformSignedAt` : la plateforme n'est jamais signataire (test de conformité §16 pt.2).
// `termsSnapshot` fige les conditions au moment de la génération, immuable même si le
// profil du prestataire change ensuite. Chaîné par hash comme les déclarations.
model PrestationContract {
  id                     String    @id @default(cuid())
  missionId              String    @unique
  mission                Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  clientId               String
  client                 User      @relation("ContractClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId             String
  provider               User      @relation("ContractProvider", fields: [providerId], references: [id], onDelete: Cascade)
  contractDocumentUrl    String?
  termsSnapshot          Json
  acceptanceDeadlineDays Int       @default(7)
  clientSignedAt         DateTime?
  providerSignedAt       DateTime?
  previousHash           String?
  currentHash            String    @unique
  createdAt              DateTime  @default(now())

  // A12 — outil de pointage optionnel. Actif seulement si les DEUX parties consentent —
  // ce sont elles qui activent, jamais la plateforme (etat-consolide-Flexwork.md §2, A12,
  // condition impérative n°3). Le refus de l'une ou l'autre est sans conséquence sur le
  // reste du contrat (condition n°1).
  clientOptedInCheckIn   Boolean @default(false)
  providerOptedInCheckIn Boolean @default(false)

  // Options de gestion des jalons (règles 18.4 et 18.8/18.9, 2026-09-08) — choisies par le
  // CLIENT à la génération du contrat (POST /api/missions/[id]/contract, même moment que la
  // décomposition en jalons elle-même) puis figées pour la vie du contrat, comme `jalons` :
  // aucune route ne permet de les changer après coup, un contrat déjà signé ne doit pas
  // changer de régime financier en cours de route.
  //
  // `financingMode` : "lump_sum" (défaut, comportement historique inchangé) — un seul RELEASE
  // par jalon (ou par contrat sans jalon), déclenché par POST .../validate à observedProgress
  // === 100. "progressive" — CHAQUE point d'étape confirmé (POST .../checkpoint) qui fait
  // progresser observedProgress déclenche EN PLUS un RELEASE partiel proportionnel à
  // l'incrément (voir src/lib/jalons.ts, progressiveReleaseIncrement) ; POST .../validate reste
  // l'action de clôture mais ne libère alors que le SOLDE restant, jamais le montant plein
  // (remainingReleasableAmount) — le total libéré sur la vie d'un jalon ne dépasse jamais son
  // montant. S'applique aussi bien à un contrat à jalons (par jalon) qu'à un contrat sans jalon
  // (sur le prix total) : un seul champ, une seule sémantique des deux côtés.
  //
  // `jalonsSequential` : sans effet si `jalons` est vide/absent. Si vrai, un jalon ne peut être
  // financé (HOLD, voir canHoldJalonSequential) que si TOUS les jalons d'ordre inférieur sont
  // au moins `valide` (le client a validé — pas besoin d'attendre la confirmation PSP du
  // RELEASE, asynchrone en prod). Par défaut (faux), tous les jalons restent finançables dans
  // n'importe quel ordre, comportement historique inchangé.
  // `retentionRate` : retenue de garantie (règle 18.10, mode J4, 2026-09-11) — fraction de
  // CHAQUE jalon retenue au séquestre au moment de sa libération, puis libérée en UNE SEULE
  // instruction finale quand tous les jalons du contrat sont `libere`. 0 (défaut) = aucune
  // retenue, comportement historique strictement inchangé : `releasableBeforeRetention`
  // (src/lib/jalons.ts) retourne alors le montant plein et aucune opération finale n'est créée.
  //
  // Toujours 0 sur un contrat SANS jalon, même si le mode en portait une (voir resolveFinancing,
  // src/lib/financing-modes.ts) : la retenue n'a de sens que s'il existe une libération
  // ultérieure à laquelle la rattacher — sur un contrat à libération unique, retenir 5 % puis
  // les libérer dans la foulée n'apporte aucune garantie, ça ajoute juste un mouvement PSP.
  //
  // Figé à la génération du contrat comme `financingMode` et `jalonsSequential` : le taux sous
  // lequel les deux parties ont signé ne change jamais.
  // `fundingGranularity` : par où l'argent ENTRE au séquestre (2026-09-14, cahier des charges §8).
  //
  //   - "per_jalon" (défaut, comportement historique) : chaque jalon porte son propre HOLD, via
  //     POST .../jalons/[jalonId]/hold. Le financement global est refusé (`use_jalon_hold`).
  //   - "upfront" : UN SEUL financement couvre tout le contrat, et les jalons le CONSOMMENT.
  //     C'est le modèle que le §8 du cahier des charges désigne explicitement — « les
  //     sous-tâches ne doivent pas créer un second séquestre ».
  //
  // Ce levier ne change RIEN aux libérations : `availableFrom` (src/lib/escrow.ts) bornait déjà
  // la libération d'un jalon par le solde du CONTRAT entier, pas par le séquestre de ce jalon.
  // La séquence du §7 — 150 000 → 130 000 → 70 000 → 20 000 → 0 — est ce que le solde produit
  // déjà. Seule l'ENTRÉE des fonds diffère.
  //
  // Figé à la génération du contrat comme les trois options ci-dessus : on ne change pas la
  // façon dont un contrat signé est financé.
  // Vérification / validation figée depuis Mission.validationMode (2026-10-01). Les contrats
  // qui avaient déjà un responsable désigné passent en "opr" à la migration.
  validationMode     ValidationMode     @default(client)
  // Responsable de chantier désigné sur CE contrat — remonté depuis SpotTimeTerms (2026-10-01)
  // pour couvrir aussi les jalons et tâches, plus seulement les relevés au temps. Révocable.
  siteManagerId      String?
  siteManager        User?              @relation("SiteManagedContracts", fields: [siteManagerId], references: [id], onDelete: SetNull)
  financingMode      FinancingMode      @default(lump_sum)
  jalonsSequential   Boolean            @default(false)
  retentionRate      Float              @default(0)
  fundingGranularity FundingGranularity @default(per_jalon)

  escrowOperations PspEscrowOperation[]
  payables         Payable[]
  spotTimeTerms    SpotTimeTerms?
  attendances      Attendance[]
  mediations       Mediation[]
  checkInEvents    CheckInEvent[]
  jalons           Jalon[]
  signatures       ContractSignature[]
  auditEntries     ContractAuditEntry[]

  @@index([missionId])
  @@index([siteManagerId])
}

// Vérification / validation d'une mission (2026-10-01) — voir Mission.validationMode.
enum ValidationMode {
  client // « Moi-même » : le client constate et valide seul
  opr // « OPR / responsable chantier » : le responsable vérifie et transmet, le client valide
}

// ---------------------------------------------------------------------------
// Jalons — paiement fractionné optionnel (2026-08-06, en réponse à principeclient.md).
// Le cycle v3 §6.3 ne décrivait qu'un seul HOLD → RELEASE par mission (voir le commentaire
// historique sur MissionProposal) ; un contrat peut désormais, optionnellement, être décomposé
// en jalons dont les montants somment exactement au prix du contrat — chacun avec son propre
// cycle HOLD → livrable → RELEASE, sans jamais introduire de solde interne (toujours des
// instructions PspEscrowOperation, jamais un mouvement de fonds détenu par la plateforme).
// Un contrat SANS jalon garde exactement l'ancien comportement (PspEscrowOperation.jalonId
// = null, un seul mouvement HOLD/RELEASE portant sur le prix total) — rien n'est cassé.
// ---------------------------------------------------------------------------

// Régime de libération des fonds — voir PrestationContract.financingMode ci-dessus pour la
// sémantique complète.
enum FinancingMode {
  lump_sum
  progressive
}

enum JalonStatus {
  en_attente // défini au contrat, pas encore financé
  fonds_sous_sequestre // HOLD confirmé par le PSP pour ce jalon
  livrable_soumis
  valide // client a validé, RELEASE transmis, en attente de confirmation PSP
  rejete // client a rejeté avec motif — le prestataire resoumet
  libere // RELEASE confirmé par le PSP — jalon payé
}

model Jalon {
  id               String             @id @default(cuid())
  contractId       String
  contract         PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ordre            Int
  titre            String
  montant          Float
  status           JalonStatus        @default(en_attente)
  rejectionReason  String?
  revisionCount    Int                @default(0)
  // Progression 0-100, déclarative — jamais de libération basée dessus seule (canDecideJalon/
  // canHoldJalon restent les gardes de statut réelles). Bornage 0-100 appliqué côté route, pas
  // en contrainte DB. Remis à 0 par le client (reject) au moment du rejet — nouveau cycle.
  declaredProgress Int                @default(0) // renseigné par le prestataire
  observedProgress Int                @default(0) // renseigné par le client — gate la validation
  // Horodatage de la première ouverture, par le CLIENT, du livrable COURANT (status
  // `livrable_soumis`) — distinct du simple "en attente" (rien constaté depuis la soumission).
  // Posé par POST .../jalons/[jalonId]/review-open, remis à null à chaque nouvelle bascule vers
  // `livrable_soumis` (voir .../jalons/[jalonId]/submit) — un nouveau tour de soumission repart
  // "non consulté". Alimente le Statut ("En attente" vs "En cours") du tableau "Validation"
  // côté client (règle de synchronisation prestataire/client, mission-history-table.tsx).
  reviewOpenedAt   DateTime?
  // Horodatage de la soumission du livrable COURANT — posé à chaque bascule vers
  // `livrable_soumis`, remis à null par toute décision qui ouvre un nouveau cycle (rejet).
  // Distinct de `updatedAt`, qui bouge au moindre geste (consultation du client, constat de
  // progression) et ne peut donc pas dater une soumission.
  //
  // Sert de POINT DE DÉPART au délai d'acceptation tacite
  // (PrestationContract.acceptanceDeadlineDays, voir src/lib/tacit-acceptance.ts) : c'est la
  // seule donnée qui dit depuis quand le client est en mesure de se prononcer. Sans elle, la
  // clause « à défaut de contestation dans ce délai » que le contrat fait signer aux deux
  // parties n'avait aucune date à laquelle s'accrocher, et n'était appliquée nulle part.
  submittedAt      DateTime?
  // Mode OPR (2026-10-01) : le responsable de chantier a vérifié ce jalon (preuves appréciées,
  // avancement constaté à 100 %) et l'a TRANSMIS au client pour validation définitive. Sans
  // cette transmission, le client ne peut pas valider. Remis à null à chaque nouvelle soumission
  // du prestataire et à chaque rejet — une vérification vaut pour UN livrable.
  verifiedAt       DateTime?
  verifiedById     String?
  verificationNote String?
  // Validation DÉFINITIVE du client (2026-10-01) — qui a validé, et quand. Distincte de la
  // vérification ci-dessus (responsable, en OPR) et de la libération confirmée par le PSP : les
  // trois gestes se tracent séparément. Nulle sur une libération par acceptation tacite, qui
  // n'est le geste de personne.
  clientValidatedById String?
  clientValidatedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  escrowOperations    PspEscrowOperation[]
  attachments         MissionAttachment[]
  progressCheckpoints ProgressCheckpoint[]
  progressRejections  ProgressRejection[]

  @@unique([contractId, ordre])
  @@index([contractId, status])
}

// Point d'étape confirmé par le CLIENT sur une progression < 100% ("validation partielle") —
// distinct de Jalon.validate / escrow.release, qui eux débloquent réellement les fonds : ceci
// ne fait QUE tracer que le client a vérifié et accepté les preuves fournies à un stade donné
// (ex. 40%), sans attendre les 100% requis pour la libération. Append-only (jamais modifié ni
// supprimé) — sert d'historique consultable par les deux parties du contrat. jalonId nul =
// mission sans jalon (pendant de Mission.observedProgress/Jalon.observedProgress).
model ProgressCheckpoint {
  id            String   @id @default(cuid())
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  jalonId       String?
  jalon         Jalon?   @relation(fields: [jalonId], references: [id], onDelete: Cascade)
  progress      Int // progression constatée au moment de la confirmation (0-100)
  validatedById String
  validatedBy   User     @relation(fields: [validatedById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([missionId, createdAt])
  @@index([jalonId])
}

// Rejet d'UNE soumission de preuves par le CLIENT ("financement par jalons à validation
// progressive", 2026-09-05) — jusqu'ici seul le DERNIER motif de rejet était conservé
// (Jalon.rejectionReason, écrasé à chaque nouveau rejet ; Mission n'en gardait même aucun,
// seulement une MissionNotification éphémère). Append-only comme ProgressCheckpoint : permet
// au dropdown "Historique" (prestataire) et à l'historique client de montrer CHAQUE soumission
// rejetée comme sa propre version (ex. "01-V1 — Rejeté"), distincte de la soumission corrigée
// qui suit — sans jamais toucher observedProgress (un rejet ne défait pas une validation
// antérieure, voir POST .../reject).
model ProgressRejection {
  id           String   @id @default(cuid())
  missionId    String
  mission      Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  jalonId      String?
  jalon        Jalon?   @relation(fields: [jalonId], references: [id], onDelete: Cascade)
  reason       String
  rejectedById String
  rejectedBy   User     @relation(fields: [rejectedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([missionId, createdAt])
  @@index([jalonId])
}

// ---------------------------------------------------------------------------
// A12 — Outil de pointage : preuve de présence entre les parties, PAS un système
// d'information de la plateforme (etat-consolide-Flexwork.md §2, A12).
// Règle structurante : « Les données de pointage TRANSITENT par la plateforme, elles ne
// l'INFORMENT PAS. » — aucune route ne doit jamais agréger, scorer, classer ou faire
// dépendre une décision (paiement, litige, visibilité) de ces évènements. Consultable
// uniquement par le client et le prestataire de la mission concernée ; producible comme
// preuve en médiation seulement à l'initiative d'une des parties (jamais consultée d'office
// par un admin). Horodatage ponctuel arrivée/départ uniquement — jamais de suivi continu
// (condition impérative n°2).
// ---------------------------------------------------------------------------

enum CheckInType {
  arrivee
  depart
}

model CheckInEvent {
  id          String             @id @default(cuid())
  contractId  String
  contract    PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyId     String // client ou prestataire du contrat — pas nécessairement le prestataire seul
  type        CheckInType
  occurredAt  DateTime           @default(now())
  gpsLat      Float?
  gpsLng      Float?
  // Rétention courte (prérequis bloquant #7, etat-consolide-Flexwork.md §5) : durée de la
  // mission + délai de contestation, puis suppression — voir src/lib/checkin-tool.ts pour
  // le calcul et la fonction de purge (à brancher sur un job planifié, non inclus ici).
  retainUntil DateTime
  createdAt   DateTime           @default(now())

  @@index([contractId, occurredAt])
}

// ---------------------------------------------------------------------------
// Phase 5 — Séquestre via PSP (modele-skillafrica-v3-Flexwork.md §6)
// ---------------------------------------------------------------------------

// ── Contrat au TEMPS (S2, §9 à §13 du cahier des charges — 2026-09-14) ─────────────────────
enum RateUnit {
  hour // S2H — tarif horaire
  day // S2J — tarif journalier
  week // S2W — tarif hebdomadaire (semaine ISO, lundi→dimanche — voir weekPeriod)
  month // S2M — tarif mensuel
}

// Statuts d'un relevé de présence. Le cycle du §20 : saisi → soumis → validé (ou refusé, ou
// contesté). `disputed` est distinct de `rejected` : un refus renvoie le relevé au prestataire
// pour correction, une contestation IMMOBILISE la somme au séquestre le temps d'arbitrer (§21).
enum AttendanceStatus {
  open
  submitted
  verified // mode OPR : constaté par le responsable de chantier, en attente du client
  approved
  rejected
  disputed
  cancelled
}

// Conditions tarifaires d'un contrat au temps. Table à part plutôt que six colonnes de plus sur
// PrestationContract : elles ne concernent que les contrats S2, et seraient nulles sur tous les
// autres.
//
// Le PLAFOND est la clé de voûte du §10 : c'est lui que le client finance d'avance
// (20 jours × 7 500 = 150 000), et c'est lui que les pointages consomment. Il est figé au
// contrat comme le reste des conditions financières.
// Mode de pointage d'une mission au temps (2026-10-01) — voir Mission.attendanceValidation.
enum AttendanceValidation {
  totale // un relevé se valide en entier, ou se refuse / se conteste
  partielle // le validateur peut ne reconnaître qu'une partie du relevé
}

model SpotTimeTerms {
  id         String             @id @default(cuid())
  contractId String             @unique
  contract   PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  rateUnit RateUnit
  rate     Float

  // Deux plafonds, et non un seul : le §7 du prompt maître demande « plafond quantité » ET
  // « plafond montant ». Ils disent la même chose quand `maxAmount = rate × maxQuantity`, mais
  // les garder distincts permet de refuser un pointage pour la bonne raison — « vous dépassez
  // les 20 jours convenus » n'est pas « le séquestre est épuisé ».
  maxQuantity Float
  maxAmount   Float

  // Heures supplémentaires (§12 du prompt maître). Non autorisées par défaut : une heure
  // supplémentaire non prévue au contrat ne doit pas pouvoir devenir payable par accident.
  overtimeAllowed Boolean @default(false)
  overtimeRate    Float?

  // Règle de validation des relevés (mode de pointage), figée depuis Mission.attendanceValidation
  // à la génération du contrat. Défaut « partielle » : comportement historique des contrats
  // générés avant son introduction.
  attendanceValidation AttendanceValidation @default(partielle)

  // Le responsable de chantier vit désormais sur le CONTRAT (PrestationContract.siteManagerId,
  // 2026-10-01) : il vérifie aussi les jalons et tâches, plus seulement les relevés.

  createdAt DateTime @default(now())
}

// Relevé de présence — le module de pointage du §20.
//
// ── Pourquoi CE modèle et pas CheckInEvent ─────────────────────────────────────────────────
// La plateforme possède déjà un outil de pointage (`CheckInEvent`), et il ne peut PAS servir
// ici. La règle A12 (src/lib/checkin-tool.ts) lui interdit explicitement d'alimenter « une
// pénalité ou une décision de litige » ; il est de surcroît optionnel — actif seulement si les
// DEUX parties y consentent — et purgé quelques jours après la mission.
//
// Un relevé qui détermine une rémunération est un instrument d'une autre nature : il ne peut
// être ni optionnel (le salaire en dépend), ni purgé à court terme (c'est une pièce de paie),
// et il tranche précisément ce que A12 interdit à l'autre de trancher. Les confondre aurait
// violé une règle de conformité existante ; ce sont donc deux modules distincts, et
// `CheckInEvent` n'est pas touché.
model Attendance {
  id         String             @id @default(cuid())
  contractId String
  contract   PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workerId   String
  worker     User               @relation("AttendanceWorker", fields: [workerId], references: [id], onDelete: Cascade)

  // Période couverte. Une journée pour S2-J, une plage horaire pour S2-H, un mois pour S2-M —
  // un seul couple de bornes pour les trois unités, plutôt qu'un champ par cas.
  periodStart DateTime
  periodEnd   DateTime

  /// Déclaré par le PRESTATAIRE. Purement déclaratif : ne paie rien par lui-même (§9).
  declaredQuantity Float
  /// Validé par le CLIENT. Nul tant qu'il ne s'est pas prononcé — c'est lui qui fait foi.
  approvedQuantity Float?
  /// Part en heures/jours supplémentaires, comprise dans `approvedQuantity`.
  overtimeQuantity Float  @default(0)

  status          AttendanceStatus @default(open)
  rejectionReason String?
  validatedById   String?
  validatedAt     DateTime?

  // Mode OPR (2026-10-01) : constat du responsable de chantier, transmis au client. La
  // quantité vérifiée borne ce que le client peut valider définitivement.
  verifiedQuantity         Float?
  verifiedOvertimeQuantity Float     @default(0)
  verifiedById             String?
  verifiedAt               DateTime?

  // Créance produite par la validation. Nulle tant que le relevé n'est pas validé : c'est la
  // matérialisation de « le pointage n'a aucun pouvoir financier direct » (§20).
  payableId String?  @unique
  payable   Payable? @relation(fields: [payableId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Double pointage d'une même période (§5 du prompt S2, « INTERDIRE : double pointage… double
  // payable d'une même journée ») : interdit par un index unique PARTIEL, posé en SQL dans la
  // migration `20260915010000_attendance_active_period_unique` —
  //
  //     UNIQUE (contractId, periodStart, periodEnd) WHERE status NOT IN ('rejected','cancelled')
  //
  // Partiel, et non `@@unique` : l'invariant est « pas deux relevés ACTIFS sur la même période »,
  // pas « pas deux lignes ». Une contrainte totale condamnait la journée dès le premier refus —
  // le prestataire ne pouvait plus corriger et redéclarer, alors que c'est précisément ce qu'un
  // refus motivé lui demande de faire.
  //
  // Prisma ne sait pas exprimer un index partiel ; il vit donc en SQL, et c'est délibéré.
  @@index([contractId, status])
  @@index([workerId])
}

enum FundingGranularity {
  per_jalon // un financement par jalon (comportement historique)
  upfront // un financement unique que les jalons consomment (§8)
}

enum EscrowInstructionType {
  hold
  release
  freeze
  refund
  // Libération FINALE de la retenue de garantie (règle 18.10, mode J4) — un type À PART et non
  // un `release` scopé contrat, parce que ce scope (jalonId null sur un contrat à jalons) est
  // DÉJÀ occupé par la médiation (POST /api/admin/mediations/[id]/respond). Les confondre a
  // deux effets, tous deux constatés avant ce correctif : la garde d'idempotence prenait un
  // release de médiation pour la retenue et ne l'émettait jamais, et le seuil de clôture de la
  // mission était franchi par un montant de médiation sans que la retenue soit partie. Un
  // discriminant explicite, jamais une convention de scope partagée.
  retention_release
  // Levée d'un gel (2026-09-14). Pendant exact de `freeze`, et comme lui NEUTRE sur le solde :
  // ni l'un ni l'autre ne déplace de fonds, ils ouvrent et referment seulement la parenthèse
  // pendant laquelle les fonds ne peuvent pas bouger.
  //
  // Son absence était une dette explicitement notée dans POST /api/admin/mediations/[id]/respond
  // (« ce que cette route ne fait toujours PAS : dégeler les fonds au PSP »). Conséquence : une
  // médiation close laissait ses fonds gelés pour toujours, et `EscrowBalance.blocked` devait
  // être artificiellement borné par le solde pour ne pas rendre `available` négatif.
  unfreeze
}

// ── Obligation de paiement (Payable) — Phase 1, 2026-09-14 ─────────────────────────────────
// Somme AUTORISÉE à être payée après validation métier, distincte de l'instruction PSP qui
// l'exécute. Le cahier des charges (§4) en fait la pièce centrale du moteur financier, et son
// absence était la raison pour laquelle l'invariant n°4 — « payableAmount <= availableEscrow »
// — ne pouvait pas être vérifié : la validation métier émettait DIRECTEMENT l'instruction, sans
// étape où poser la question.
//
// Règle : VALIDATED ne signifie pas PAID. Entre les deux, un contrôle de solde.
//
// ── Portée générique, volontairement ───────────────────────────────────────────────────────
// `sourceType` + `sourceId` identifient l'objet métier payé, et `contractId` est NULLABLE alors
// même qu'il est toujours renseigné aujourd'hui. Ce n'est pas un relâchement : le dépôt porte
// encore deux moteurs financiers (PspEscrowOperation pour les missions, GigOrderEscrowOperation
// pour les commandes Gig), et leur unification est une migration à part entière. Une commande
// Gig n'a pas de PrestationContract — exiger `contractId` ici obligerait à migrer Payable une
// seconde fois le jour de cette unification. L'identité d'un payable est sa SOURCE, pas son
// contrat.
enum PayableSourceType {
  jalon // un jalon de contrat, validé ou accepté tacitement
  mission // livrable d'une mission sans jalon
  retention // libération finale de la retenue de garantie (mode J4)
  attendance // relevé de présence validé (modes S2)
  mediation // montant arrêté par une résolution de médiation
  gig_order // commande Gig — réservé, émis à l'unification des deux moteurs (0.1)
}

// Seuls les états que le système sait RÉELLEMENT produire et distinguer. Le cahier des charges
// en propose huit ; `DRAFT`, `READY_FOR_PAYOUT`, `CANCELLED` et `DISPUTED` n'ont aujourd'hui
// aucun producteur — un payable naît validé, et le contrôle de solde qui le rendrait « prêt »
// se fait dans la même transaction que l'instruction. Les ajouter maintenant, c'est créer des
// états qu'aucun chemin n'atteint et que le code devra pourtant traiter partout.
// `validated` est le seul état d'attente réel : il existe pour le jour où le solde ne couvre
// PAS le payable (recharge du séquestre, §13) — le payable attend alors son financement.
enum PayableStatus {
  validated // autorisé par la validation métier ; pas encore instruit au PSP
  instructed // instruction PSP transmise, en attente du webhook
  paid // confirmé par le PSP
  failed // refusé par le PSP — reprenable, le payable reste dû
}

model Payable {
  id         String              @id @default(cuid())
  contractId String?
  contract   PrestationContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  missionId  String?
  sourceType PayableSourceType
  sourceId   String
  amount     Float
  currency   String              @default("XOF")
  status     PayableStatus       @default(validated)

  // Instruction qui l'exécute. Nulle tant que le payable n'est pas instruit — c'est
  // exactement la distinction que ce modèle apporte.
  escrowOperationId String?             @unique
  escrowOperation   PspEscrowOperation? @relation(fields: [escrowOperationId], references: [id], onDelete: SetNull)

  // Clé d'idempotence MÉTIER (et non technique comme `pspReference`) : elle décrit l'ÉVÉNEMENT
  // payé, pas l'instruction qui le transporte. Deux validations concurrentes du même jalon au
  // même palier produisent la même clé, donc un seul payable.
  //
  // Un jalon peut légitimement en produire PLUSIEURS en financement progressif (un par palier
  // confirmé) : la clé porte donc le cumul visé, pas seulement la source. Une contrainte
  // `@@unique([sourceType, sourceId])` aurait interdit le mode J3 tout entier.
  idempotencyKey String @unique

  attendance Attendance?

  createdAt   DateTime  @default(now())
  validatedAt DateTime  @default(now())
  paidAt      DateTime?

  // Reprise automatique d'un versement refusé par le PSP (2026-10-01) — réservée aux créances
  // de présence, voir src/lib/psp/payable-retry.ts. `nextRetryAt` nul : aucune reprise prévue.
  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  @@index([contractId, status])
  @@index([sourceType, sourceId])
  @@index([status, nextRetryAt])
}

enum PspOperationStatus {
  pending
  confirmed
  failed
}

// Portée d'une opération de séquestre (2026-09-14). Discriminant EXPLICITE plutôt qu'une
// déduction depuis « lequel des deux identifiants est renseigné ? » : une requête qui veut les
// opérations d'un domaine le dit, et l'index la sert.
enum EscrowSourceType {
  mission_contract // contrat de prestation (missions, jalons, retenue, médiation)
  gig_order // commande Gig (achat direct d'une prestation forfaitaire)
}

// La plateforme instruit, ne détient jamais les fonds (§6.2). Remplace intégralement
// TransactionEscrow/Wallet/WalletTransaction/Retrait — aucun solde interne n'existe plus.
//
// ── Registre UNIQUE des deux domaines (2026-09-14) ─────────────────────────────────────────
// Cette table portait les seules opérations de mission ; les commandes Gig avaient la leur,
// `GigOrderEscrowOperation` — mêmes colonnes, mêmes enums, aucun code partagé. C'était le
// « deuxième moteur financier » que le cahier des charges interdit de créer, et il existait
// déjà. Il était en outre incomplet : aucune instruction `release` n'existait côté Gig, si bien
// qu'une commande livrée ne pouvait jamais payer son prestataire.
//
// L'unification porte sur le REGISTRE et sur ses primitives (émission sous verrou, idempotence,
// règle de solde), pas sur les transitions métier : un contrat a des jalons, une retenue, un
// financement progressif et une médiation ; une commande Gig n'a rien de tout cela. Ce qui
// devait cesser d'être écrit deux fois, c'est la façon de compter l'argent — pas la façon de
// conduire une mission.
//
// `contractId` et `orderId` sont tous deux nullables : exactement UN des deux est renseigné,
// selon `sourceType`. Un discriminant plutôt qu'une table par domaine, parce que les deux
// répondent aux mêmes questions comptables et doivent y répondre identiquement.
model PspEscrowOperation {
  id                String                @id @default(cuid())
  sourceType        EscrowSourceType      @default(mission_contract)
  contractId        String?
  contract          PrestationContract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  orderId           String?
  order             GigOrder?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // null = mouvement portant sur le prix total du contrat (comportement historique, contrat
  // sans jalon) ; renseigné = mouvement scopé à UN jalon (montant du jalon, pas du contrat).
  jalonId           String?
  jalon             Jalon?                @relation(fields: [jalonId], references: [id], onDelete: Cascade)
  pspName           String
  pspReference      String?               @unique
  amount            Float
  currency          String                @default("XOF")
  instructionType   EscrowInstructionType
  instructionSentAt DateTime              @default(now())
  pspConfirmedAt    DateTime?
  webhookReference  String?
  status            PspOperationStatus    @default(pending)

  // ── Boîte d'envoi (outbox, 2026-10-01) ───────────────────────────────────────────────────
  // L'instruction est ÉCRITE dans la transaction métier, puis TRANSMISE au PSP hors de toute
  // transaction (src/lib/psp/dispatch.ts). Ces champs disent où en est la transmission — distincte
  // du dénouement (`status`), que seul le webhook signé fait avancer.
  dispatchStatus    PspDispatchStatus     @default(a_envoyer)
  dispatchAttempts  Int                   @default(0)
  nextDispatchAt    DateTime              @default(now())
  /// Bail du transmetteur qui a réclamé la ligne : passé ce délai, un autre peut la reprendre.
  dispatchLeaseUntil DateTime?
  dispatchedAt      DateTime?
  lastDispatchError String?

  payable Payable?

  @@index([contractId, status])
  @@index([orderId, status])
  @@index([jalonId])
  @@index([dispatchStatus, nextDispatchAt])
  @@index([status, dispatchedAt])
}

enum PspDispatchStatus {
  a_envoyer // écrite, pas encore transmise au PSP
  en_cours // réclamée par un transmetteur (bail en cours)
  envoyee // le PSP a accusé réception
  echec_envoi // transmission abandonnée après le nombre maximal de tentatives — à reprendre à la main
}

// ── Boîte de réception des webhooks PSP (inbox, 2026-10-01) ──────────────────────────────────
// La route POST /api/webhooks/psp vérifie la signature, consigne le corps BRUT ici et répond
// aussitôt ; le traitement (applyPspWebhookEvent) est fait par le worker. Un PSP qui renvoie le
// même évènement retombe sur la même ligne (contrainte unique), jamais sur un second traitement.
model PspInboundEvent {
  id            String              @id @default(cuid())
  pspReference  String
  event         String
  /// Corps tel que reçu : la signature HMAC porte sur lui, il doit pouvoir être revérifié.
  rawBody       String
  signature     String
  status        PspInboundStatus    @default(recu)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  leaseUntil    DateTime?
  lastError     String?
  receivedAt    DateTime            @default(now())
  processedAt   DateTime?

  @@unique([pspReference, event])
  @@index([status, nextAttemptAt])
}

enum PspInboundStatus {
  recu // consigné, à traiter
  en_cours // réclamé par un worker (bail en cours)
  traite // appliqué (ou rejeu idempotent)
  rejete // refus définitif (opération déjà soldée, hors périmètre, introuvable après reprises)
  echec // erreur technique répétée — à examiner
}

// ---------------------------------------------------------------------------
// Phase 6 — Médiation (modele-skillafrica-v3-Flexwork.md §8) — remplace Litige (arbitrage
// opposable). La plateforme facilite, ne tranche jamais (test de conformité §16 pt.6).
// ---------------------------------------------------------------------------

enum MediationOutcome {
  en_cours
  agreement
  no_agreement
  withdrawn
}

model Mediation {
  id                 String             @id @default(cuid())
  contractId         String
  contract           PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedById         String
  openedBy           User               @relation("MediationOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  reason             String
  clientElements     Json?
  providerElements   Json?
  proposedResolution String?
  // Montant à libérer au prestataire si les deux parties acceptent (règle 18.11, 2026-09-11).
  // Renseigné par l'Admin Médiation avec sa proposition. Avant ce champ, la route d'acceptation
  // libérait `mission.budget` — le BUDGET PUBLIÉ, ni le prix réellement contracté
  // (termsSnapshot.prix, voir contractPrice) ni ce qui restait effectivement séquestré : sur un
  // contrat à jalons dont trois sur quatre étaient déjà payés, un accord repayait le budget
  // entier. Une résolution de médiation doit dire COMBIEN ; elle ne peut pas le deviner.
  resolutionAmount   Float?
  // Part RENDUE AU CLIENT par la résolution (§24 du cahier des charges, 2026-09-14).
  //
  // Une résolution dispose de trois destinations, et non d'une seule :
  //   `resolutionAmount` → libéré au prestataire
  //   `refundAmount`     → rendu au client
  //   le reste           → demeure bloqué (le dégel est partiel, voir la route de réponse)
  //
  // L'asymétrie d'avant était lourde : une médiation qui donnait raison au client ne pouvait pas
  // lui rendre son argent. Elle savait payer le prestataire, ou ne rien faire.
  refundAmount       Float?
  // Statut de la mission avant l'ouverture de la médiation, pour le restaurer à la clôture.
  // `mediation_ouverte` écrasait le cycle de vie sans aucun écrivain de retour : une médiation
  // refusée ou ouverte par erreur gelait la mission DÉFINITIVEMENT (plus aucun point d'étape,
  // validation ni libération possible — canDecideDeliverable n'accepte que `livrable_soumis`).
  previousStatus     MissionStatus?
  clientAccepted     Boolean?
  providerAccepted   Boolean?
  outcome            MediationOutcome   @default(en_cours)
  mediatorAdminId    String?
  mediatorAdmin      User?              @relation("MediationAdmin", fields: [mediatorAdminId], references: [id])
  createdAt          DateTime           @default(now())
  closedAt           DateTime?

  @@index([contractId, outcome])
}

// ---------------------------------------------------------------------------
// Phase 7 — Risque élevé & assurance à la mission (modele-skillafrica-v3-Flexwork.md §7)
// Prérequis bloquant : produit d'assurance à la mission disponible au Bénin + statut de
// distribution validé — ne jamais activer en production sans confirmation (voir US-703).
// ---------------------------------------------------------------------------

enum ClientAcknowledgementType {
  no_insurance
  unverified_qualification
}

model ClientAcknowledgement {
  id                  String                    @id @default(cuid())
  clientId            String
  client              User                      @relation("AcknowledgementClient", fields: [clientId], references: [id], onDelete: Cascade)
  missionId           String
  mission             Mission                   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  acknowledgementType ClientAcknowledgementType
  textSnapshot        String
  acknowledgedAt      DateTime                  @default(now())
  ipAddress           String?

  @@index([missionId])
}

enum MissionInsuranceStatus {
  active
  expired
  cancelled
}

model MissionInsurance {
  id              String                 @id @default(cuid())
  missionId       String                 @unique
  mission         Mission                @relation(fields: [missionId], references: [id], onDelete: Cascade)
  insurerName     String
  policyReference String?
  premiumAmount   Float
  coverageCeiling Float
  coverageStart   DateTime
  coverageEnd     DateTime
  status          MissionInsuranceStatus @default(active)
}

// ---------------------------------------------------------------------------
// Phase 8 — Modération & traçabilité
// ---------------------------------------------------------------------------

// Append-only, justification obligatoire non vide (US-801). Toute route admin doit écrire
// ici via un helper partagé (src/lib/admin-audit.ts) plutôt qu'une journalisation ad hoc.
model AdminAuditLog {
  id            String   @id @default(cuid())
  adminId       String
  admin         User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action        String
  targetType    String
  targetId      String
  justification String
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
  @@index([adminId, createdAt])
}

enum VerificationSubjectType {
  kyc
  declaration
}

// Historique global chaîné (US-804), même mécanisme de hash que ProfessionalDeclaration —
// couvre KYC et déclarations dans un seul flux consultable en cas de recours.
model VerificationHistoryEntry {
  id           String                  @id @default(cuid())
  subjectType  VerificationSubjectType
  subjectId    String
  event        String
  previousHash String?
  currentHash  String                  @unique
  createdAt    DateTime                @default(now())

  @@index([subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Feature flags — prérequis bloquants (etat-consolide-Flexwork.md §5), pas des filières.
// Création manuelle uniquement, jamais d'auto-activation par le code applicatif.
// ---------------------------------------------------------------------------

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  zone      String
  enabled   Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([key, zone])
}

// ---------------------------------------------------------------------------
// Signature numérique — certificats RSA, signatures, piste d'audit
// Inspiré du modèle eIDAS niveau avancé : chaque partie (client/prestataire)
// possède un certificat RSA-2048 dont la clé privée est chiffrée AES-256-GCM.
// ---------------------------------------------------------------------------

enum CertificateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model DigitalCertificate {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commonName          String
  email               String
  organization        String?
  validFrom           DateTime          @default(now())
  validUntil          DateTime
  status              CertificateStatus @default(ACTIVE)
  publicKey           String
  encryptedPrivateKey String
  keyFingerprint      String            @unique
  keySalt             String
  keyIv               String
  keyAuthTag          String
  revokedAt           DateTime?
  revokeReason        String?
  createdAt           DateTime          @default(now())

  signatures        ContractSignature[]
  GigOrderSignature GigOrderSignature[]

  @@index([userId, status])
}

model ContractSignature {
  id              String             @id @default(cuid())
  contractId      String
  contract        PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  certificateId   String
  certificate     DigitalCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  signedDataHash  String
  signature       String
  signingMethod   String             @default("RSA-SHA256")
  signedAt        DateTime           @default(now())
  verifiedAt      DateTime?
  signerIp        String?
  signerUserAgent String?

  @@index([contractId])
  @@index([certificateId])
}

model ContractAuditEntry {
  id              String             @id @default(cuid())
  contractId      String
  contract        PrestationContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  event           String
  description     String
  metadata        Json               @default("{}")
  previousHash    String?
  currentHash     String             @unique
  systemSignature String?
  createdAt       DateTime           @default(now())

  @@index([contractId, createdAt])
}

// ---------------------------------------------------------------------------
// Modèle Gig (recommandation #3 — REVUE-MODELE-CONTRAT-VS-IMPLEMENTATION.md)
// Le PRESTATAIRE publie un Gig à prix fixe, le CLIENT l'achète. Flux de signature
// INVERSE du modèle Mission : le client signe EN PREMIER (1/2, il achète et les fonds
// sont mis sous séquestre), le prestataire signe EN DERNIER (2/2, il accepte la
// commande) dans un délai de 24h — passé ce délai, remboursement automatique au
// client (aucune pénalité : personne n'est engagé tant que les deux signatures ne
// sont pas apposées). Prix fixe affiché (pas de candidature ni devis), livraison
// sous delaiJours. Réutilise DigitalCertificate (clé RSA-2048, passphrase) — les
// tables de signature/audit sont dédiées (GigOrderSignature/GigOrderAuditEntry)
// pour ne pas coupler le modèle Mission existant (PrestationContract).
// ---------------------------------------------------------------------------

enum GigStatus {
  brouillon
  publie
  cloture
}

// Formules d'un Gig (2026-11-08) : trois offres à prix progressifs.
enum GigTier {
  basique
  standard
  premium
}

// Une formule d'un Gig : ce qui est inclus, son prix, son délai, ses révisions. Un Gig publié
// depuis le 2026-11-08 en porte exactement trois (src/lib/gig-rules.ts) ; les Gigs antérieurs
// n'en ont aucune et gardent leur prix unique (Gig.prix / Gig.delaiJours).
model GigPackage {
  id          String  @id @default(cuid())
  gigId       String
  gig         Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier        GigTier
  titre       String
  description String
  prix        Float
  delaiJours  Int
  revisions   Int

  @@unique([gigId, tier])
}

model Gig {
  id          String    @id @default(cuid())
  providerId  String
  provider    User      @relation("GigProvider", fields: [providerId], references: [id], onDelete: Cascade)
  titre       String
  description String
  domaine     String
  prix        Float
  currency    String    @default("XOF")
  delaiJours  Int
  tags        String[]
  status      GigStatus @default(brouillon)
  // Visuels (2026-11-08) : jusqu'à 3 photos (bucket « gigs »), la première servant de
  // couverture et toutes défilant en carrousel sur les cartes ; lien vidéo YouTube / Vimeo
  // facultatif, rendu en lecteur intégré.
  imagePaths     String[] @default([])
  videoUrl       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packages GigPackage[]
  orders   GigOrder[]

  @@index([status, createdAt])
  @@index([providerId])
}

enum GigOrderStatus {
  created // acheté — en attente de la signature du client (1/2)
  client_signed // client a signé + fonds sous séquestre — le prestataire doit signer sous 24h
  active // les 2 signatures — mission engagée, livraison en cours
  completed // livraison validée / clôturée
  cancelled // délai 24h dépassé (remboursement déclenché) ou annulation
  refunded // remboursement confirmé
}

model GigOrder {
  id               String         @id @default(cuid())
  gigId            String
  gig              Gig            @relation(fields: [gigId], references: [id], onDelete: Cascade)
  clientId         String
  client           User           @relation("GigOrderClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId       String
  provider         User           @relation("GigOrderProvider", fields: [providerId], references: [id], onDelete: Cascade)
  montant          Float
  currency         String         @default("XOF")
  // Formule achetée (2026-11-08) — null pour un Gig sans formules (prix unique, antérieur).
  packageTier      GigTier?
  termsSnapshot    Json // snapshot immuable du Gig au moment de l'achat
  status           GigOrderStatus @default(created)
  clientSignedAt   DateTime?
  providerSignedAt DateTime?
  refundedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  signatures       GigOrderSignature[]
  auditEntries     GigOrderAuditEntry[]
  escrowOperations PspEscrowOperation[]

  @@index([gigId])
  @@index([clientId, status])
  @@index([providerId, status])
}

model GigOrderSignature {
  id              String             @id @default(cuid())
  orderId         String
  order           GigOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  certificateId   String
  certificate     DigitalCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  signedDataHash  String
  signature       String
  signingMethod   String             @default("RSA-SHA256")
  signedAt        DateTime           @default(now())
  verifiedAt      DateTime?
  signerIp        String?
  signerUserAgent String?

  @@index([orderId])
  @@index([certificateId])
}

model GigOrderAuditEntry {
  id              String   @id @default(cuid())
  orderId         String
  order           GigOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event           String
  description     String
  metadata        Json     @default("{}")
  previousHash    String?
  currentHash     String   @unique
  systemSignature String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

// ── Journal des échanges avec le PSP (2026-09-15) ───────────────────────────────────────────
// Chaque message reçu du PSP — webhook réel, console de la PSP virtuelle, confirmation
// automatique — est consigné avec son ISSUE : appliqué, rejeu ignoré, ou rejeté avec son motif.
//
// Le registre (`PspEscrowOperation`) ne garde que l'état FINAL d'une instruction. Il ne dit ni
// combien de fois le PSP a rappelé, ni qu'un webhook mal signé a été refusé, ni qu'une référence
// inconnue a été présentée. Ce sont pourtant exactement les signaux d'un incident d'intégration
// ou d'une tentative de fraude — et ils disparaissaient sans trace.
//
// Volontairement SANS clé étrangère : un journal d'audit ne doit pas s'effacer en cascade quand
// une mission ou un contrat est supprimé, et il doit pouvoir consigner une référence qui ne
// correspond à AUCUNE opération (c'est même l'un des cas qu'il sert à voir). Append-only : aucune
// route ne le modifie.
enum PspEventChannel {
  webhook // appel HTTP du PSP sur /api/webhooks/psp
  virtual_console // action manuelle sur la console de la PSP virtuelle (développement)
  autoconfirm // confirmation immédiate de la PSP virtuelle (ESCROW_STUB_AUTOCONFIRM)
  reconciliation // statut relu auprès du PSP par le worker (opération restée en attente)
}

enum PspEventOutcome {
  applied // accepté : l'opération a changé d'état
  replayed // même dénouement déjà enregistré — idempotent, aucune écriture
  rejected // refusé : signature, référence inconnue, conflit d'état, charge invalide…
}

model PspEventLog {
  id              String                 @id @default(cuid())
  channel         PspEventChannel
  event           String
  pspReference    String?
  operationId     String?
  contractId      String?
  orderId         String?
  instructionType EscrowInstructionType?
  amount          Float?
  outcome         PspEventOutcome
  error           String?
  signatureValid  Boolean
  /// Temps de traitement côté plateforme, en millisecondes.
  durationMs      Int
  payload         Json
  receivedAt      DateTime               @default(now())

  @@index([receivedAt])
  @@index([pspReference])
  @@index([operationId])
  @@index([outcome, receivedAt])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// Administration du frontend (2026-09-21)
//
// Jusqu'ici, tout ce que le visiteur voit avant de se connecter était écrit en dur dans des
// composants React : les neuf catégories de `CategoriesBar`, les huit vignettes de
// `PopularServices`, la grille d'icônes de `src/app/page.tsx`, les garanties de `TrustedBy`,
// les entrées « Explorer » du `Header`, les quatre colonnes du `Footer`. Changer un libellé
// public exigeait un déploiement.
//
// Ces tables portent ce contenu. Deux principes les gouvernent :
//
//   1. BROUILLON ≠ PUBLIÉ. Les tables ci-dessous sont l'espace de TRAVAIL de l'administrateur.
//      Le public ne les lit JAMAIS : il lit l'instantané figé du dernier `FrontendRelease`.
//      Sans cette séparation, une frappe en cours d'édition serait immédiatement en ligne.
//
//   2. Le frontend garde ses valeurs codées en dur comme SOCLE DE REPLI. Une base vide, une
//      requête en échec ou une publication jamais faite rendent exactement la page
//      d'aujourd'hui. L'administration ajoute un pouvoir ; elle n'introduit pas une
//      dépendance qui casse la page d'accueil quand la base ne répond pas.
// ═══════════════════════════════════════════════════════════════════════════════════════════

// Cycle de vie commun à tout contenu éditorial, repris de la maquette Flexwork-Taxonomie :
// brouillon → publié → désactivé → archivé.
//
// `desactive` et `archive` se ressemblent mais ne disent pas la même chose : désactivé est un
// retrait TEMPORAIRE décidé par l'éditeur (la saison est finie, on remettra), archivé est un
// retrait DÉFINITIF d'un élément qu'on ne peut pas supprimer parce que des missions y font
// référence. Les deux sont invisibles du public ; seul l'archivé sort des écrans d'édition.
enum FrontendStatus {
  brouillon
  publie
  desactive
  archive
}

// ── Taxonomie : Catégorie → Métier → Service ────────────────────────────────────────────────
//
// Architecture reprise telle quelle de `flexwork_job` (prisma/schema.prisma, modèles Categorie,
// Metier, Service) : mêmes niveaux, mêmes champs, mêmes contraintes d'unicité, mêmes tables.
// Seules manquent les relations vers les modèles que ce dépôt n'a pas (Demande,
// PrestataireMetier, PrestataireService).
model Categorie {
  id          String    @id @default(cuid())
  libelle     String    @unique
  description String?
  icon        String? // Icône ou emoji
  ordre       Int       @default(0) // Ordre d'affichage
  // ── Barrière d'âge portée par la CATÉGORIE (2026-09-24) ───────────────────────────────
  // Le contrôle d'âge (A13) s'évaluait sur la FILIÈRE du compte (artisan, manœuvre,
  // expert_btp_autres). Or la filière dit COMMENT on exerce, pas QUEL travail on fait — et
  // depuis que « Prestataire indépendant » a remplacé « Expert digital », elle ne délimite
  // plus rien : un électricien pouvait s'y déclarer et échapper au contrôle d'âge.
  //
  // La barrière se dresse désormais au moment où le prestataire choisit son MÉTIER, donc sa
  // catégorie — l'axe qui dit réellement de quel travail il s'agit. Marquée par
  // l'administrateur dans la taxonomie, comme le palier de risque du métier.
  //
  // Conséquence voulue : plus aucune catégorie n'est marquée à l'installation, donc la
  // barrière ne se déclenche nulle part tant qu'un administrateur ne l'a pas posée. C'est un
  // choix de classification, pas un oubli — ne pas pré-remplir à sa place.
  requiresAgeCheck Boolean @default(false)
  // ── Secteur de la marketplace (2026-09-28) ─────────────────────────────────────────────
  // Regroupe les catégories en trois grands pôles — DIGITAL, BTP, SERVICES — pour l'entrée de
  // la marketplace. Classement posé par l'administrateur dans la taxonomie, jamais déduit du
  // libellé : `null` = « non classée », visible comme telle dans le backoffice.
  //
  // Le secteur décrit le TRAVAIL (comme la catégorie qu'il regroupe), pas la façon d'exercer :
  // il ne se confond pas avec la filière du compte (`User.role`).
  secteur     Secteur?
  // ── Vérification tierce autorisée (2026-10-01) ─────────────────────────────────────────
  // Le mode de vérification « OPR / responsable chantier » n'est PROPOSÉ à la publication que
  // pour les catégories où un contrôle sur site par un tiers a un sens (maçonnerie, électricité,
  // plomberie…) — pas pour un logo ou une traduction. Le réglage AUTORISE le mode ; c'est la
  // mission qui le choisit (Mission.validationMode).
  //
  // Même règle que `requiresAgeCheck` : aucune catégorie n'est marquée à l'installation, c'est
  // l'administrateur qui classe — ne pas pré-remplir à sa place, ni le déduire du secteur.
  allowsOprVerification Boolean @default(false)
  metiers     Metier[]
  missions    Mission[]
  qualificationSpecialties QualificationSpecialty[]

  @@map("categories")
}

model Metier {
  id          String    @id @default(cuid())
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  libelle     String // "Plombier", "Électricien", "Maçon", etc.
  description String?
  // ── Palier de risque DU MÉTIER (2026-09-23) ────────────────────────────────────────────
  // Il appartenait à `DomainRiskLevel`, une table indexée sur un libellé libre qui ne
  // correspondait à aucun métier du catalogue : 4 lignes sur 220, et les 4 lignes « high »
  // (Électricité, Travail en hauteur, Gros œuvre, Engins) ne tombaient sur RIEN. L'obligation
  // d'assurance qui en dépendait ne pouvait donc jamais se déclencher — ni à la candidature,
  // ni au séquestre.
  //
  // Le risque est désormais porté par le métier lui-même, saisi par l'administrateur au moment
  // où il crée ou modifie ce métier. Deux conséquences voulues : le risque ne peut plus être
  // orphelin (il voyage avec la ligne à laquelle il s'applique), et il est connu du formulaire
  // dès la SÉLECTION du métier, sans requête supplémentaire.
  //
  // `insuranceRequired` n'est PAS une colonne : la règle du modèle est « obligatoire si et
  // seulement si le palier est `high` » (modele-skillafrica-v3 §7.2), et un booléen séparé
  // serait une seconde vérité à tenir d'accord avec la première.
  riskLevel   RiskLevel @default(low)
  services    Service[]
  missions    Mission[]
  profiles    Profile[]

  @@unique([categorieId, libelle])
  @@index([categorieId])
  @@map("metiers")
}

model Service {
  id           String  @id @default(cuid())
  metierId     String
  metier       Metier  @relation(fields: [metierId], references: [id])
  libelle      String // "Réparation de fuite", "Installation robinet", etc.
  description  String?
  dureeEstimee Int? // Durée estimée en minutes

  @@unique([metierId, libelle])
  @@index([metierId])
  @@map("services")
}

// ── Sections d'accueil ─────────────────────────────────────────────────────────────────────
//
// Une section = un bloc de la page d'accueil. `key` est le point d'ancrage du composant React
// qui la consomme (`categories_bar` → CategoriesBar.tsx) : c'est une clé technique, immuable,
// jamais affichée. Les champs de texte portent l'en-tête du bloc, les `items` son contenu
// répétitif — ce qui couvre d'un seul modèle une barre de catégories, une grille de vignettes
// et une liste de garanties, dont la seule différence réelle est le gabarit de rendu.
model FrontendSection {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  title    String?
  subtitle String?
  ctaText  String?
  ctaLink  String?

  sortOrder Int            @default(0)
  status    FrontendStatus @default(brouillon)

  items FrontendSectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

model FrontendSectionItem {
  id        String          @id @default(cuid())
  sectionId String
  section   FrontendSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  label    String
  sublabel String?
  href     String?
  icon     String?
  // Classe utilitaire Tailwind ou valeur hexadécimale, selon le gabarit de la section.
  // Le composant décide de l'usage ; l'administration ne fait que transporter la valeur.
  color    String?
  imageUrl String?

  sortOrder Int            @default(0)
  status    FrontendStatus @default(brouillon)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

// ── Menus (Header « Explorer », colonnes du Footer) ────────────────────────────────────────
//
// `href` est validé à l'écriture contre les routes réellement présentes dans src/app : le
// Footer a déjà porté quatre liens morts (« Carrières », « Presse », « Blog AfroTech »,
// « Événements Dakar »), retirés à la main le 2026-09-09. Rendre le menu éditable sans cette
// garde reviendrait à rouvrir exactement cette porte, mais cette fois sans déploiement pour
// s'en apercevoir.
model FrontendMenuItem {
  id          String  @id @default(cuid())
  menu        String
  label       String
  href        String
  description String?

  sortOrder Int            @default(0)
  status    FrontendStatus @default(brouillon)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menu, sortOrder])
}

// ── Pages éditoriales ──────────────────────────────────────────────────────────────────────
//
// Le CORPS de ces pages reste du JSX dans src/app/(public)/ — l'administration ne prétend pas
// gérer un contenu qu'elle ne stocke pas. Ce modèle porte ce qui est réellement éditable sans
// déploiement : le titre d'onglet, la description de référencement, et la présence de la page
// dans les menus. `path` est en lecture seule côté administration : il est créé par le code,
// et une entrée dont la route a disparu est signalée comme orpheline plutôt que servie.
model FrontendPage {
  id             String         @id @default(cuid())
  path           String         @unique
  title          String
  seoTitle       String?
  seoDescription String?
  status         FrontendStatus @default(publie)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Réglages globaux (SEO du layout racine, identité du site) ──────────────────────────────
model FrontendSetting {
  key       String   @id
  value     String
  group     String
  label     String
  updatedAt DateTime @updatedAt
}

// ── Publication ────────────────────────────────────────────────────────────────────────────
//
// Une publication fige l'état COMPLET des tables ci-dessus dans `snapshot`, et c'est ce
// document — jamais les tables — que sert l'API publique. Trois propriétés en découlent :
//
//   · le brouillon ne fuit pas : une section en cours d'écriture reste invisible ;
//   · l'ETag est honnête : `version` change si et seulement si le contenu servi a changé,
//     ce qu'un hachage des tables de travail ne garantirait pas (un `updatedAt` bouge à
//     chaque frappe sans rien changer au rendu public) ;
//   · le retour arrière est une opération ordinaire : republier l'instantané de la v23 crée
//     une v25 au contenu identique. L'historique ne se réécrit pas, il s'allonge.
model FrontendRelease {
  id       String @id @default(cuid())
  version  Int    @unique
  snapshot Json

  publishedAt   DateTime @default(now())
  publishedById String?
  publishedBy   User?    @relation("FrontendReleasePublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  note                  String?
  // Renseigné quand la publication est un retour arrière : version dont l'instantané a été
  // repris. Sans ce champ, une v25 identique à la v23 serait indiscernable d'une réécriture.
  rolledBackFromVersion Int?

  @@index([publishedAt])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// Signalements (2026-09-21) — US-802, Phase 8 du modèle v3
//
// La page publique /signalement postait vers /api/reports, une route qui n'a jamais existé :
// chaque signalement partait dans un 404, et l'utilisateur voyait « Échec de l'envoi ». Or le
// §13 fait de la Modération un pouvoir qui « agit sur signalement » : sans cette table, le rôle
// n'avait littéralement aucune file de travail.
//
// Un signalement OUVRE UNE REVUE, il ne sanctionne rien. `retenu` dit que le modérateur l'a
// jugé fondé ; le retrait d'une déclaration ou la suspension d'un compte restent des gestes
// distincts, chacun justifié et journalisé de son côté. Lier automatiquement l'un à l'autre
// ferait d'un clic sur « retenu » une sanction sans motif propre.
// ═══════════════════════════════════════════════════════════════════════════════════════════

enum ReportTargetType {
  declaration
  profile
  mission
  review
}

enum ReportStatus {
  ouvert
  retenu
  classe
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  // Facultatif : le formulaire public accepte un signalement sans identifiant précis.
  targetId   String?
  reason     String

  // Signalement possible sans compte. `sourceHash` (empreinte HMAC de l'adresse IP, jamais
  // l'adresse elle-même) sert uniquement à limiter la cadence d'une même source anonyme.
  reporterId String?
  reporter   User?   @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)
  sourceHash String?

  status       ReportStatus @default(ouvert)
  handledById  String?
  handledBy    User?        @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([sourceHash, createdAt])
  @@index([reporterId, createdAt])
}

// ── Boîte d'envoi des e-mails (2026-10-01) ─────────────────────────────────────────────────────
// En mode `worker` (PAYMENT_QUEUE_MODE), une notification n'envoie plus l'e-mail dans la requête :
// elle l'écrit ici, et le worker le remet au serveur SMTP (src/lib/mail-queue.ts). Une action
// utilisateur ne paie plus la latence SMTP, et un SMTP indisponible ne perd plus d'e-mail : la
// ligne est reprise avec délai croissant.
model EmailOutbox {
  id            String      @id @default(cuid())
  to            String
  subject       String
  text          String
  html          String?
  /// Type de notification à l'origine, pour le diagnostic (ex. `deliverable_tacitly_accepted`).
  kind          String?
  status        EmailStatus @default(a_envoyer)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  leaseUntil    DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

enum EmailStatus {
  a_envoyer
  en_cours
  envoye
  echec // abandonné après le nombre maximal de tentatives
}

// ── Exploitation : alertes et battement du worker (2026-10-01) ────────────────────────────────
// Une alerte par anomalie (`key` stable, ex. `psp.outbox_abandoned`) : ouverte à la première
// détection, rappelée périodiquement tant qu'elle dure, close — et annoncée close — quand elle
// disparaît. C'est ce qui évite d'envoyer le même message toutes les cinq minutes.
model OpsAlert {
  id             String    @id @default(cuid())
  key            String    @unique
  severity       String
  title          String
  detail         String
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastNotifiedAt DateTime?
  resolvedAt     DateTime?

  @@index([resolvedAt])
}

// Chaque réplique du worker y inscrit son passage (src/worker/index.ts). GET /api/health le lit :
// un worker arrêté se voit de l'extérieur, alors que ses propres alertes se taisent avec lui.
model WorkerHeartbeat {
  id         String   @id
  host       String
  pid        Int
  startedAt  DateTime
  lastSeenAt DateTime

  @@index([lastSeenAt])
}

// ── Spécialités de diplômes (2026-11-07) ───────────────────────────────────────────────────
//
// Liste ALIMENTÉE PAR LES PRESTATAIRES : l'onglet Expérience propose un niveau fixe (CAP, DT,
// DUT, BTS, Licence professionnelle, Ingénieur, Master professionnel) puis laisse SAISIR la
// spécialité. Chaque spécialité déclarée avec un diplôme est ajoutée ici (POST
// /api/declarations), et revient en suggestion aux suivants — « Plomberie sanitaire » saisie
// une fois n'a plus à être retapée, ni à exister en trois orthographes.
//
// `normalized` (minuscules, sans accents ni espaces superflus) porte l'unicité : « Génie
// civil », « genie civil » et « GÉNIE  CIVIL » sont une seule spécialité, affichée sous la
// première graphie reçue (`libelle`). `categorieId` : domaine dans lequel elle a été saisie la
// première fois, pour classer les suggestions — pas une contrainte.
//
// ⚠️ Contenu saisi par des utilisateurs et montré à d'autres : aucune modération à ce jour.
model QualificationSpecialty {
  id          String     @id @default(cuid())
  libelle     String
  normalized  String     @unique
  categorieId String?
  categorie   Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([categorieId])
  @@map("qualification_specialties")
}

// Sessions révoquées à la déconnexion (2026-11-09). La session est un JWT sans état : effacer
// le cookie ne suffit pas — une requête /api/auth/session encore en vol au moment de la
// déconnexion peut le réécrire. Chaque connexion porte un identifiant (`sid`) ; à la
// déconnexion il est inscrit ici, et le callback `jwt` (src/auth.ts) refuse tout token qui le
// porte. Les lignes expirent avec le token lui-même (`expiresAt`) et sont purgées ensuite.
model RevokedSession {
  sid       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
