# Copier ce fichier en .env.local pour le développement local sur Laragon.

# --- Base de données (Postgres local via Laragon, auth "trust" sans mot de passe) ---
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/flexwork_dev?schema=public"

# --- Environnement ---
NODE_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ACADEMY_URL="http://localhost:3000/academy-placeholder"

# --- Auth (à brancher en Sprint 1 - US-101) ---
AUTH_SECRET="change-me-in-each-environment"

# --- Stockage fichiers (KYC, livrables) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# --- Escrow (Sprint 4 - US-401/US-1314) ---
# Secret partagé avec le webhook FedaPay/Paystack (à générer et stocker en secrets manager en prod).
ESCROW_WEBHOOK_SECRET="change-me-in-each-environment"
# --- PSP virtuelle (sandbox de développement, 2026-08-31) ---
# En dev (NEXT_PUBLIC_APP_ENV ≠ "production"), les instructions escrow sont traitées par une
# PSP virtuelle qui simule le prestataire agréé : page de paiement Mobile Money simulée sur
# /psp-sandbox/payer, console opérateur sur /psp-sandbox, confirmations par webhook signé
# HMAC via le même chemin que le vrai PSP (US-503). Jamais active en production.
# UNIQUEMENT en dev local : confirme automatiquement chaque instruction (HOLD/RELEASE/FREEZE/
# REFUND) dès sa création pour tester le flux complet sans écran intermédiaire — équivalent
# du callback provider FedaPay. Ne jamais mettre "true" en staging/production : seul le vrai
# webhook doit confirmer un paiement.
ESCROW_STUB_AUTOCONFIRM="true"

# --- Notifications e-mail (OTP par e-mail, mise en relation mission) via Mailtrap ---
# Sandbox (dev) : Mailtrap > Email Testing > Inboxes > [ton inbox] > SMTP Settings.
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAIL_FROM="Flexwork <no-reply@flexwork.app>"

# --- Crons (annulations temporelles : /api/cron/devis-expirations, /api/cron/contract-expirations) ---
# Bearer token requis par GET /api/cron/* — appelé avec le header `Authorization: Bearer <CRON_SECRET>`
# (planifier côté infra : Vercel Cron, cron système, etc.). À générer en secret manager en prod.
CRON_SECRET="change-me-in-each-environment"
