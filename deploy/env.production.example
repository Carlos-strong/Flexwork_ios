# Modèle de /opt/flexwork/.env.production sur le VPS (ce fichier-ci est versionné, l'autre JAMAIS).
# Générer chaque secret avec : openssl rand -base64 48

# --- Adresse publique ---
# Sans domaine : l'IP du VPS en HTTP. Avec domaine : https://app.exemple.com
# (figée au BUILD dans le JS client : la changer impose `docker compose ... up -d --build`).
NEXT_PUBLIC_APP_URL="http://203.0.113.10"
# Ce que Caddy sert : « :80 » sans domaine, « app.exemple.com » pour le HTTPS automatique.
SITE_ADDRESS=":80"
NEXT_PUBLIC_ACADEMY_URL=""

# L'image tourne en NODE_ENV=production : la PSP virtuelle (/psp-sandbox) y est TOUJOURS
# coupée (garde de src/lib/psp-virtual.ts), quelle que soit cette valeur. Aucun paiement ne
# sera confirmé tant que le webhook d'un vrai PSP n'est pas branché.
NEXT_PUBLIC_APP_ENV="production"

# --- Base de données (conteneur `db`, jamais exposé hors du VPS) ---
POSTGRES_USER="flexwork"
POSTGRES_PASSWORD="A_GENERER"
POSTGRES_DB="flexwork"

# --- Auth.js ---
AUTH_SECRET="A_GENERER"
# Derrière Caddy, Auth.js doit accepter l'hôte transmis par le proxy.
AUTH_TRUST_HOST="true"

# --- Secrets applicatifs ---
ESCROW_WEBHOOK_SECRET="A_GENERER"
ESCROW_STUB_AUTOCONFIRM="false"
CRON_SECRET="A_GENERER"

# --- Worker ---
WORKER_TZ="Africa/Porto-Novo"

# --- E-mails (SMTP réel ; Mailtrap Sending : live.smtp.mailtrap.io:587) ---
MAILTRAP_HOST="live.smtp.mailtrap.io"
MAILTRAP_PORT="587"
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAIL_FROM="Flexwork <no-reply@exemple.com>"

# --- Alertes d'exploitation (optionnel) ---
# ALERT_WEBHOOK_URL=""
# ALERT_EMAILS="ops@exemple.com"
